#!/usr/bin/env sh
# Images are optimised locally or not at all: Astro uses passthroughImageService()
# and Vercel Image Optimization is off, so committed bytes are the bytes served.
# Reject anything unoptimised before it can reach the repo.
node scripts/check-images.mjs --staged

# No TODO is ever published: a TODO, FIXME, TBD or TKTK marker in a staged
# content file stops the commit (editorial/CLAUDE.md, "No run leaves a TODO behind").
node scripts/check-content.mjs --staged

                    <span class="text-[11px] font-mono uppercase tracking-[0.14em] text-[var(--color-brand-orange)]">{step.when}</span>
                  </div>
                  <p class="text-[15px] lg:text-base text-[var(--color-text-body)] leading-relaxed max-w-xl">{step.body}</p>

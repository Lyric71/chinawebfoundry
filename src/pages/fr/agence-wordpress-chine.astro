  <!-- ============= ICP & HÉBERGEMENT : aide à la décision ============= -->
  <section class="relative section-spacing bg-[var(--color-surface-light)] overflow-hidden">
    <span aria-hidden="true" data-float class="absolute right-[-2rem] top-[6%] text-[18rem] lg:text-[22rem] font-medium font-[var(--font-heading)] text-[var(--color-brand-orange)]/[0.05] leading-none select-none pointer-events-none hidden md:block">证</span>
    <div class="relative mx-auto max-w-[1240px] section-padding">
      <div class="max-w-3xl mb-10 lg:mb-12" data-reveal>

  <!-- ============= CE QUI CASSE : le tableau de bord ============= -->
  <section class="relative section-spacing bg-white overflow-hidden">
    <span aria-hidden="true" data-float="slow" class="absolute left-[-3rem] top-[10%] text-[18rem] lg:text-[24rem] font-medium font-[var(--font-heading)] text-[var(--color-brand-orange)]/[0.04] leading-none select-none pointer-events-none hidden md:block">修</span>
    <div class="relative mx-auto max-w-[1100px] section-padding">
      <div class="max-w-3xl mb-10 lg:mb-12" data-reveal>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-brand-orange)]/10 border border-[var(--color-brand-orange)]/20 mb-5">
          <span class="text-[11px] font-mono font-semibold uppercase tracking-[0.16em] text-[var(--color-brand-orange)]">Le travail technique · 技术</span>

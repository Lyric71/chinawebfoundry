        </button>
        <span id="fix-label-after" class="text-sm font-medium font-[var(--font-button)] text-[var(--color-text-muted)] transition-colors duration-300">Après notre refonte</span>
      </div>

      <div id="fix-rows" data-state="broken" class="space-y-2.5">

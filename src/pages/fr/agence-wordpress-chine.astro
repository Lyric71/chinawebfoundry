          <a href="/fr/ressources/guide-web-chine/licence-icp-entreprises-etrangeres/" class="text-[var(--color-brand-orange-text)] font-medium">la licence ICP pour les entreprises étrangères</a> et
          <a href="/fr/ressources/guide-web-chine/hebergement-web-chine/" class="text-[var(--color-brand-orange-text)] font-medium">l’hébergement d’un site en Chine</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ============= MÉTHODE : frise au fil du scroll ============= -->
  <section class="relative section-spacing bg-white overflow-hidden">
    <span aria-hidden="true" data-float="slow" class="absolute right-[-3rem] bottom-[5%] text-[18rem] lg:text-[24rem] font-medium font-[var(--font-heading)] text-[var(--color-brand-orange)]/[0.04] leading-none select-none pointer-events-none hidden md:block">程</span>

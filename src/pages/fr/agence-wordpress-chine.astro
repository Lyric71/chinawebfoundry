---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import FAQItem from '../../components/pages/FAQItem.astro';
import ScrollEffects from '../../components/global/ScrollEffects.astro';
import PageScrollEffects from '../../components/pages/ScrollEffects.astro';
import { getCollection } from 'astro:content';
import { localizePath } from '../../i18n/routes';

const metaTitle = 'Agence WordPress en Chine : créer, héberger, référencer | ChinaWebFoundry';
const metaDescription = 'Agence WordPress spécialiste de la Chine : hébergement adapté au pare-feu, licence ICP, site rapide, SEO Baidu. Lancez et référencez votre site en Chine.';
const canonicalPath = '/fr/agence-wordpress-chine/';

const casestudies = (await getCollection('casestudies-fr'))
  .filter((cs) => cs.data.published)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://www.chinawebfoundry.com';
const pageUrl = `${siteOrigin}${canonicalPath}`;

const services = [
  {
    key: 'dev',
    title: 'Design & développement WordPress',
    body: 'Des thèmes dessinés pour l’internaute chinois et développés sans un seul appel vers un domaine bloqué. Responsive, prêts pour le bilingue, testés à 375 px sur les téléphones réellement en usage ici.',
    deliverable: 'Un site WordPress en production, contrôlé depuis des connexions de Chine continentale.',
    href: '/fr/services/design-ux-ui/',
    linkLabel: 'Design & développement',
  },
  {
    key: 'hosting',
    title: 'Hébergement & CDN compatibles pare-feu',
    body: 'Hébergement en Chine continentale ou à Hong Kong, chez Alibaba Cloud ou Tencent Cloud, derrière un CDN chinois. Le cap : moins de 2 secondes dans les grandes villes, sous surveillance depuis des nœuds en Chine.',
    deliverable: 'Une infrastructure dont vous vérifiez vous-même les temps de réponse en Chine.',
    href: '/fr/services/hebergement-chine/',
    linkLabel: 'Hébergement Chine',
  },
  {
    key: 'icp',
    title: 'Licence ICP & accompagnement réglementaire',
    body: 'Nous montons votre dossier ICP Bei’an, le déposons au MIIT via votre hébergeur, et vous disons sans détour si votre activité relève plutôt de la licence commerciale.',
    deliverable: 'Un numéro ICP affiché dans votre pied de page, enregistré au nom de votre société.',
    href: '/fr/ressources/guide-web-chine/licence-icp-entreprises-etrangeres/',
    linkLabel: 'Comment fonctionne le dépôt ICP',
  },
  {
    key: 'seo',
    title: 'SEO Baidu & référencement en Chine',
    body: 'Travail technique et éditorial pour Baidu, Sogou et 360 : Baidu Webmaster Tools configuré, mots-clés recherchés en chinois simplifié, contenus signés par des rédacteurs natifs.',
    deliverable: 'Un site indexé par Baidu, un plan de mots-clés et un rapport de positions chaque mois.',
    href: '/fr/services/baidu-seo/',
    linkLabel: 'Service SEO Baidu',
  },
  {
    key: 'migration',
    title: 'Migration & sauvetage de site',
    body: 'Votre site WordPress existe, mais en Chine il rame ou il casse. Nous le déplaçons vers une infrastructure taillée pour la Chine et retirons les ressources bloquées, sans toucher à vos contenus ni à vos positions.',
    deliverable: 'Le même site, affiché en quelques secondes depuis Shanghai.',
    href: '/fr/services/migration-chine/',
    linkLabel: 'Migration Chine',
  },
  {
    key: 'care',
    title: 'Maintenance & support',
    body: 'Mises à jour du cœur et des plugins éprouvées face au pare-feu avant toute mise en ligne, correctifs de sécurité, surveillance depuis des nœuds chinois. Et un humain qui vous répond sous 24 heures.',
    deliverable: 'Un rapport mensuel et un site qui garde sa vitesse.',
    href: '/fr/services/maintenance-support/',
    linkLabel: 'Formules de maintenance',
  },
];

const breakages = [
  {
    resource: 'Google Fonts',
    broken: 'Plus de 20 secondes de texte invisible, jusqu’à ce que le navigateur renonce.',
    fixed: 'Chaque police auto-hébergée en WOFF2 sur votre propre serveur.',
  },
  {
    resource: 'reCAPTCHA',
    broken: 'Des formulaires qui ne partent jamais. Des demandes de contact perdues sans bruit.',
    fixed: 'Champs pièges et anti-spam qui passe en Chine, à la place du widget de Google.',
  },
  {
    resource: 'Google Maps',
    broken: 'Un rectangle gris là où devrait figurer l’adresse de vos bureaux.',
    fixed: 'Une carte AutoNavi (Gaode) ou Baidu Maps intégrée.',
  },
  {
    resource: 'Vidéos YouTube',
    broken: 'Des lecteurs vidéo morts sur l’ensemble de vos pages produits.',
    fixed: 'Vidéo auto-hébergée, ou intégrée via Tencent Video ou Youku.',
  },
  {
    resource: 'Gravatar',
    broken: 'Des blocs commentaires et des fiches auteurs qui bloquent la page entière.',
    fixed: 'Avatars distants coupés, images servies en local.',
  },
  {
    resource: 'Scripts sur CDN',
    broken: 'Un jQuery servi par ajax.googleapis.com paralyse tout ce qui en dépend.',
    fixed: 'Chaque script regroupé et servi depuis votre propre hébergement.',
  },
  {
    resource: 'Google Analytics',
    broken: 'Aucune donnée de fréquentation, et une requête bloquée de plus sur chaque page.',
    fixed: 'Baidu Tongji, ou un outil auto-hébergé comme Matomo.',
  },
];

const processSteps = [
  {
    title: 'Cadrage',
    when: 'Semaines 1-2',
    body: 'Audit de votre site depuis une connexion shanghaïenne, objectifs posés pour le marché chinois, périmètre et budget arrêtés.',
  },
  {
    title: 'Design',
    when: 'Semaines 2-4',
    body: 'Maquettes et direction artistique pensées pour l’internaute chinois : mises en page plus denses, mobile en premier, rendu vérifié dans WeChat.',
  },
  {
    title: 'Développement',
    when: 'Semaines 4-8',
    body: 'Thème et plugins écrits sans la moindre ressource bloquée. Chaque dépendance auto-hébergée dès le premier commit.',
  },
  {
    title: 'Tests de performance en Chine',
    when: 'Semaines 8-9',
    body: 'Le site est chargé depuis des nœuds de Pékin, Shanghai et Canton. Tout ce qui dépasse 2 secondes est corrigé avant même que vous receviez un lien de préproduction.',
  },
  {
    title: 'ICP & hébergement',
    when: 'En parallèle',
    body: 'Dossier ICP monté et déposé, hébergement et CDN configurés. Le tout avance au rythme du développement, sans un jour de plus au calendrier.',
  },
  {
    title: 'Fondations SEO Baidu',
    when: 'Semaines 9-10',
    body: 'Baidu Webmaster Tools, sitemap soumis, mots-clés chinois cartographiés, pages travaillées. Avant le lancement, pas après coup.',
  },
  {
    title: 'Mise en ligne',
    when: 'Semaine 10',
    body: 'DNS basculé, CDN préchauffé, et un contrôle le jour même depuis des connexions de Chine continentale.',
  },
  {
    title: 'Suivi',
    when: 'En continu',
    body: 'Mises à jour, surveillance et rapport mensuel au sein d’une formule de maintenance. La plupart de nos clients restent plusieurs années.',
  },
];

const alternatives = [
  {
    title: 'WordPress, localisé dans les règles',
    body: 'Le bon choix quand votre équipe maîtrise déjà l’éditeur, publie souvent ou gère plusieurs langues. Hébergé en Chine avec des ressources locales, il s’affiche en moins de 2 secondes et Baidu l’indexe sans difficulté.',
    verdict: 'Notre choix par défaut pour les sites de marque à forte dimension éditoriale.',
  },
  {
    title: 'WeChat seul ou un CMS local',
    body: 'Un compte officiel WeChat pèse en Chine, et nous savons le construire. Seul, en revanche, vous louez votre audience à Tencent. Et un CMS local enferme vos contenus dans une plateforme inutilisable pour votre siège.',
    verdict: 'Précieux à côté d’un site. Risqué à sa place.',
  },
  {
    title: 'Astro ou headless',
    body: 'Quand la vitesse prime et que le contenu bouge peu, un site statique ou headless devance WordPress en performance. Nous en construisons aussi, et nous le recommandons quand le projet s’y prête.',
    verdict: 'Le brief tranche. Si WordPress ne convient pas à votre projet, nous vous le disons dès le premier échange.',
  },
];

const industries = [
  'B2B & industrie',
  'Éducation & universités',
  'Hôtellerie & voyage',
  'Luxe & marques grand public',
  'SaaS & technologie',
  'Sciences de la vie',
  'Multinationales entrant en Chine',
];

const differentiators = [
  {
    title: 'Nous testons là où vivent vos visiteurs',
    body: 'Chaque livraison est contrôlée depuis des connexions chinoises, à Pékin, Shanghai et Canton. Un voyant vert à Francfort ne dit rien à un visiteur de Chengdu.',
  },
  {
    title: 'L’ICP traité en mandarin',
    body: 'Notre équipe dépose les dossiers ICP directement auprès des hébergeurs et du MIIT, en mandarin, depuis des années. Vous signez les documents, nous faisons le reste.',
  },
  {
    title: 'L’expertise Baidu, en interne',
    body: 'Mots-clés recherchés en chinois, Baidu Webmaster Tools, contenus rédigés par des natifs. L’équipe qui construit votre site est celle qui le fait monter.',
  },
  {
    title: 'Bilingue, un interlocuteur unique',
    body: 'Un référent vous répond en français ou en anglais sous 24 heures, épaulé par l’équipe de production de Shanghai. Nous ne sous-traitons jamais.',
  },
];

const faqs = [
  {
    id: 'works-in-china',
    q: 'WordPress fonctionne-t-il vraiment en Chine ?',
    a: 'Oui, à condition de l’héberger en Chine ou à proximité et de le débarrasser des ressources bloquées. Le cœur de WordPress ne pose aucun problème. Les ennuis viennent des thèmes et des plugins qui appellent Google Fonts, reCAPTCHA, Gravatar et d’autres services bloqués. Nous avons livré plus de 50 sites WordPress qui s’affichent en moins de 2 secondes depuis la Chine continentale.',
  },
  {
    id: 'icp-needed',
    q: 'Ai-je besoin d’une licence ICP pour mon site WordPress ?',
    a: 'Uniquement si vous hébergez en Chine continentale. Le dépôt ICP Bei’an couvre les sites vitrines et marketing ; il exige une entité juridique chinoise. Vendre directement aux consommateurs chinois depuis le site relève en général de la licence ICP commerciale, plus exigeante. Sans entité chinoise, l’hébergement à Hong Kong dispense d’ICP et reste performant.',
  },
  {
    id: 'fix-without-rebuild',
    q: 'Mon site WordPress est lent en Chine. Pouvez-vous le corriger sans le refaire ?',
    a: 'Dans la plupart des cas, oui. La lenteur tient presque toujours à deux causes, des ressources tierces bloquées et un hébergement lointain, et les deux se corrigent sans toucher au design ni aux contenus. Nous migrons le site vers un hébergement prêt pour la Chine, localisons polices et scripts, remplaçons les plugins fautifs. Notre scanner gratuit vous montre précisément ce qui bloque le vôtre.',
  },
  {
    id: 'timeline',
    q: 'Combien de temps pour lancer un site WordPress en Chine ?',
    a: 'Comptez 8 à 12 semaines du premier appel à la mise en ligne pour un nouveau site de marque. Migrer et localiser un site global existant demande 14 à 20 semaines, réécriture des contenus et indexation Baidu comprises. Le dépôt ICP prend 2 à 4 semaines et avance en parallèle du développement.',
  },
  {
    id: 'woocommerce',
    q: 'WooCommerce fonctionne-t-il en Chine ?',
    a: 'Oui, moyennant des ajustements locaux. Le paiement passe par WeChat Pay et Alipay plutôt que par Stripe ou PayPal, et la vente sur le marché domestique suppose la licence ICP commerciale et une entité chinoise. Beaucoup de marques étrangères démarrent par l’e-commerce transfrontalier, moins contraignant. Nous avons construit les deux.',
  },
  {
    id: 'google-rankings',
    q: 'Optimiser pour la Chine pénalisera-t-il mes positions Google ailleurs ?',
    a: 'Non. Votre site Chine vit à côté de votre site global, en général sur un sous-domaine ou un domaine .cn, avec des balises hreflang qui indiquent à Google et à Baidu quelle version sert quel public. Vos positions actuelles ne bougent pas.',
  },
  {
    id: 'chinese-content',
    q: 'Prenez-vous en charge le chinois simplifié et le multilingue ?',
    a: 'Oui. Nous travaillons avec WPML et Polylang pour le WordPress multilingue, et nos rédacteurs chinois natifs écrivent les contenus en chinois simplifié. Un chinois traduit à la machine sonne aussi faux pour un acheteur chinois qu’un français traduit à la machine pour vous. Nous n’y touchons donc pas.',
  },
  {
    id: 'cost',
    q: 'Combien coûte un projet WordPress pour la Chine ?',
    a: 'Tout dépend du nombre de pages, de la nécessité ou non d’un dépôt ICP, du niveau d’hébergement, du volume à localiser et d’un éventuel volet e-commerce. Nous chiffrons un prix ferme après un appel de cadrage ; l’appel comme le devis sont gratuits. Maintenance et hébergement fonctionnent ensuite au forfait mensuel.',
  },
];

// Schéma Service : ancre l'entité « agence WordPress en Chine » pour cette page
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: 'Agence WordPress en Chine',
  description: 'Agence WordPress dédiée au marché chinois : design, développement, hébergement adapté au pare-feu, licence ICP, SEO Baidu, migration et maintenance de sites WordPress en Chine continentale.',
  serviceType: 'Développement WordPress',
  provider: { '@id': `${siteOrigin}/#organization` },
  areaServed: { '@type': 'Country', name: 'China' },
  url: pageUrl,
  inLanguage: 'fr-FR',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services WordPress pour la Chine',
    itemListElement: services.map((s, i) => ({
      '@type': 'Offer',
      position: i + 1,
      itemOffered: {
        '@type': 'Service',
        name: s.title,
        description: s.body,
        url: `${siteOrigin}${s.href}`,
      },
    })),
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteOrigin}/fr/` },
    { '@type': 'ListItem', position: 2, name: 'Agence WordPress en Chine', item: pageUrl },
  ],
};
---

<PageLayout
  title={metaTitle}
  description={metaDescription}
  heroPage={true}
  lang="fr"
  jsonLd={[serviceLd, faqLd, breadcrumbLd]}
  alternateUrls={{ en: '/wordpress-agency-china/', fr: '/fr/agence-wordpress-chine/', es: '/es/agencia-wordpress-china/', de: '/de/wordpress-agentur-china/' }}
>
  <ScrollEffects />
  <PageScrollEffects />

  <!-- ============= HERO avec simulation réseau ============= -->
  <section
    data-hero
    class="relative bg-[var(--color-surface-dark)] overflow-hidden flex flex-col"
  >
    <div class="absolute inset-0">
      <img
        src="/images/hero-wordpress-agency-china.webp"
        alt=""
        width="1600"
        height="900"
        class="absolute inset-0 w-full h-full object-cover scale-105 opacity-60"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0e]/97 via-[#0a0a0e]/88 to-[#0a0a0e]/60"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0e]/70 via-transparent to-[#0a0a0e]"></div>
    </div>

    <div aria-hidden="true" class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute top-[8%] -left-32 w-[600px] h-[600px] rounded-full bg-[var(--color-brand-orange)]/[0.16] blur-[140px]"></div>
      <div class="absolute bottom-[5%] right-[15%] w-[500px] h-[500px] rounded-full bg-[#EF4444]/[0.08] blur-[160px]"></div>
    </div>

    <div
      aria-hidden="true"
      class="absolute inset-0 [background-image:radial-gradient(rgba(255,255,255,0.07)_1px,transparent_1px)] [background-size:38px_38px] pointer-events-none"
    ></div>

    <div class="relative z-10 mx-auto w-full max-w-[1240px] section-padding flex-1 pt-32 lg:pt-40 pb-16 lg:pb-24">
      <div class="grid grid-cols-12 gap-10 lg:gap-8 items-center">
        <!-- Gauche : titre -->
        <div class="col-span-12 lg:col-span-6">
          <div class="flex items-center gap-3 mb-6">
            <div class="h-px w-10 bg-[var(--color-brand-orange)]"></div>
            <span class="text-xs lg:text-sm font-medium tracking-[0.18em] text-[var(--color-brand-orange)] uppercase">
              Spécialistes WordPress · Installés à Shanghai
            </span>
          </div>

          <h1 class="text-[clamp(2.3rem,4.6vw,3.9rem)] font-medium font-[var(--font-heading)] text-white leading-[1.04] tracking-tight">
            Agence WordPress en Chine :
            <span class="block mt-2">
              <span class="bg-gradient-to-r from-[var(--color-brand-orange)] via-[#FF9466] to-[var(--color-brand-orange)] bg-clip-text text-transparent">
                créer, héberger, référencer
              </span>
            </span>
            <span class="block mt-2 text-white/95">derrière le Grand Pare-feu.</span>
          </h1>

          <p class="mt-7 text-base lg:text-lg text-white/65 leading-relaxed max-w-[560px]">
            Nos sites WordPress s’affichent en moins de 2 secondes en Chine continentale. Conception, développement, hébergement, licence ICP, SEO Baidu : une seule équipe s’en charge, depuis Shanghai.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-4">
            <Button href="/fr/contact/" variant="primary" size="lg">Demander un devis</Button>
            <a
              href="/fr/china-site-scanner/"
              class="inline-flex items-center gap-2 px-7 py-3 text-base font-medium font-[var(--font-button)] rounded-[var(--radius-pill)] border border-white/20 bg-white/[0.04] backdrop-blur-md text-white hover:bg-white/[0.10] hover:border-white/40 hover:-translate-y-0.5 no-underline transition-all duration-200"
            >
              Audit Chine gratuit
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>

          <div class="mt-12 grid grid-cols-3 gap-6 max-w-xl">
            <div class="border-l-2 border-[var(--color-brand-orange)]/70 pl-4">
              <div class="text-2xl lg:text-3xl font-medium font-[var(--font-heading)] text-white leading-none"><span data-counter data-counter-suffix="+">50</span></div>
              <div class="text-[10px] uppercase tracking-[0.18em] text-white/50 mt-2">Sites WordPress livrés</div>
            </div>
            <div class="border-l-2 border-white/15 pl-4">
              <div class="text-2xl lg:text-3xl font-medium font-[var(--font-heading)] text-white leading-none"><span data-counter data-counter-suffix="+">15</span></div>
              <div class="text-[10px] uppercase tracking-[0.18em] text-white/50 mt-2">Années en Chine</div>
            </div>
            <div class="border-l-2 border-white/15 pl-4">
              <div class="text-2xl lg:text-3xl font-medium font-[var(--font-heading)] text-white leading-none">&lt;2s</div>
              <div class="text-[10px] uppercase tracking-[0.18em] text-white/50 mt-2">Chargement grandes villes</div>
            </div>
          </div>
        </div>

        <!-- Droite : simulation réseau en direct -->
        <div class="col-span-12 lg:col-span-6" data-reveal="right">
          <div id="net-sim" class="relative max-w-[560px] mx-auto lg:ml-auto rounded-2xl border border-white/12 bg-[#101016]/90 backdrop-blur-md shadow-[0_40px_90px_-30px_rgba(0,0,0,0.8)] overflow-hidden">
            <div class="flex items-center gap-3 px-4 py-3 border-b border-white/10 bg-white/[0.03]">
              <div class="flex gap-1.5" aria-hidden="true">
                <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#FEBC2E]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#28C840]"></span>
              </div>
              <div class="flex-1 flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/[0.06] text-[12px] font-mono text-white/60 truncate">
                <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 3.935"/></svg>
                votremarque.com
              </div>
              <div class="hidden sm:flex items-center gap-1.5 text-[11px] font-mono text-white/50 shrink-0">
                <svg class="w-3.5 h-3.5 text-[var(--color-brand-orange)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Shanghai, CN
              </div>
            </div>

            <div class="h-[3px] bg-white/[0.06]">
              <div id="sim-progress" class="h-full w-0 bg-[#EF4444] transition-none"></div>
            </div>

            <div class="flex items-center justify-between px-4 pt-3.5 pb-1">
              <span id="sim-phase" class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[0.14em] text-white/60">
                <span id="sim-phase-dot" class="w-1.5 h-1.5 rounded-full bg-[#EF4444]"></span>
                <span id="sim-phase-label">Installation WordPress standard</span>
              </span>
              <span class="text-[13px] font-mono text-white/80 tabular-nums">
                <span id="sim-timer">0,0</span>&nbsp;s
              </span>
            </div>

            <div id="sim-rows" class="px-4 pb-3 pt-1.5 min-h-[248px] flex flex-col gap-1.5" aria-live="off"></div>

            <div id="sim-verdict" class="mx-4 mb-4 rounded-lg px-3.5 py-2.5 text-[12.5px] font-mono border border-white/10 bg-white/[0.04] text-white/45 transition-colors duration-500">
              En attente de la première requête...
            </div>
          </div>
          <p class="mt-3 text-center lg:text-right text-[11px] font-mono uppercase tracking-[0.14em] text-white/35">
            Simulation fidèle aux audits que nous réalisons chaque jour
          </p>
        </div>
      </div>
    </div>

    <!-- Séparateur pare-feu -->
    <div class="relative z-10 border-t border-white/[0.07]">
      <div class="mx-auto max-w-[1240px] section-padding py-4 flex items-center justify-between gap-4">

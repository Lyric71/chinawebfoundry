  #fix-rows[data-state='fixed'] .fix-chip-fixed { display: inline-flex; opacity: 1; animation: chip-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both; animation-delay: var(--stagger); }
  @keyframes chip-pop {
    from { transform: scale(0.6); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .fix-text-fixed { opacity: 0; visibility: hidden; }
  #fix-rows[data-state='fixed'] .fix-text-broken { opacity: 0; visibility: hidden; }

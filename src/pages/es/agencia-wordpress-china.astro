  }
  .sim-status.ok      { background: rgba(34, 197, 94, 0.12); border: 1px solid rgba(34, 197, 94, 0.35); color: #4ade80; }
  .sim-status.blocked { background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; animation: sim-flash 0.5s ease; }
  .sim-status.slow    { background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.35); color: #fbbf24; }
  @keyframes sim-flash {
    0% { box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.25); }

  /* ---------- fix switchboard states ---------- */
  .fix-row { background: #fff; border-color: var(--color-surface-border); transition-delay: var(--stagger); }
  #fix-rows[data-state='broken'] .fix-row { border-color: rgba(239, 68, 68, 0.25); background: rgba(239, 68, 68, 0.03); }

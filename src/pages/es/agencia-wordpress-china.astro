  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
    .sim-row { animation: none; opacity: 1; transform: none; }
    .svc-card .lat-bar { transform: scaleX(1); transition: none; }
    .fix-row, .fix-dot, .fix-chip-fixed { transition: none; animation: none; }
  }
</style>

<script>
  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function fmtSeconds(n: number) {
    return n.toFixed(1).replace('.', ',');
  }

  /* ============ 1. Simulación de red del hero ============ */
  const BROKEN_REQUESTS = [
    { url: 'sumarca.com', status: 'ok', label: '200 · 1,9 s', t: 1.9 },

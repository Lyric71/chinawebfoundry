---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import FAQItem from '../../components/pages/FAQItem.astro';
import ScrollEffects from '../../components/global/ScrollEffects.astro';
import PageScrollEffects from '../../components/pages/ScrollEffects.astro';
import { getCollection } from 'astro:content';
import { localizePath } from '../../i18n/routes';

const metaTitle = 'Agencia WordPress en China: crear, alojar y posicionar | ChinaWebFoundry';
const metaDescription = 'Agencia WordPress especializada en China: alojamiento a prueba de cortafuegos, licencia ICP, carga rápida y SEO en Baidu para que su web funcione y posicione en China.';
const canonicalPath = '/es/agencia-wordpress-china/';

const casestudies = (await getCollection('casestudies-es'))
  .filter((cs) => cs.data.published)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://www.chinawebfoundry.com';
const pageUrl = `${siteOrigin}${canonicalPath}`;

const services = [
  {
    key: 'dev',
    title: 'Diseño y desarrollo WordPress',
    body: 'Temas diseñados a medida para el usuario chino y construidos sin una sola llamada a dominios bloqueados. Adaptables a cualquier pantalla, preparados para varios idiomas y probados a 375 px en los teléfonos que de verdad se usan aquí.',
    deliverable: 'Un sitio WordPress en producción, comprobado desde conexiones de China continental.',
    href: '/es/servicios/diseno-ux-ui/',
    linkLabel: 'Diseño y desarrollo',
  },
  {
    key: 'hosting',
    title: 'Alojamiento y CDN a prueba de cortafuegos',
    body: 'Alojamiento en China continental o en Hong Kong, sobre Alibaba Cloud o Tencent Cloud y con una CDN china por delante. Trabajamos con un objetivo claro: cargas por debajo de los 2 segundos en las grandes ciudades, vigiladas desde nodos dentro de China.',
    deliverable: 'Una infraestructura cuyos tiempos de respuesta en China podrá comprobar usted mismo.',
    href: '/es/servicios/alojamiento-china/',
    linkLabel: 'Alojamiento en China',
  },
  {
    key: 'icp',
    title: 'Licencia ICP y acompañamiento regulatorio',
    body: 'Preparamos su expediente ICP Bei’an, lo presentamos ante el MIIT a través de su proveedor de alojamiento y le decimos con franqueza si su modelo de negocio requiere, en realidad, la licencia comercial.',
    deliverable: 'Un número ICP visible en el pie de su web, registrado a nombre de su sociedad.',
    href: '/es/recursos/guia-web-china/licencia-icp-empresas-extranjeras/',
    linkLabel: 'Cómo funciona el registro ICP',
  },
  {
    key: 'seo',
    title: 'SEO en Baidu y buscadores chinos',
    body: 'Trabajo técnico y de contenidos para Baidu, Sogou y 360: configuramos Baidu Webmaster Tools, investigamos las palabras clave en chino simplificado y encargamos los textos a redactores nativos.',
    deliverable: 'Un sitio indexado en Baidu, con su plan de palabras clave y un informe mensual de posiciones.',
    href: '/es/servicios/baidu-seo/',
    linkLabel: 'Servicio de SEO en Baidu',
  },
  {
    key: 'migration',
    title: 'Migración y rescate de sitios',
    body: 'Su sitio WordPress ya existe, pero en China se arrastra o directamente no responde. Lo trasladamos a una infraestructura preparada para el país y retiramos los recursos bloqueados sin tocar sus contenidos ni sus posiciones.',
    deliverable: 'El mismo sitio, cargando en cuestión de segundos desde Shanghái.',
    href: '/es/servicios/migracion-china/',
    linkLabel: 'Migración a China',
  },
  {
    key: 'care',
    title: 'Mantenimiento y soporte',
    body: 'Actualizaciones del núcleo y de los plugins probadas frente al cortafuegos antes de publicarse, parches de seguridad, vigilancia desde nodos chinos y una persona que le responde en menos de 24 horas.',
    deliverable: 'Un informe mensual y un sitio que conserva su velocidad.',
    href: '/es/servicios/mantenimiento-soporte/',
    linkLabel: 'Planes de mantenimiento',
  },
];

const breakages = [
  {
    resource: 'Google Fonts',
    broken: 'Más de 20 segundos con el texto invisible, hasta que el navegador tira la toalla.',
    fixed: 'Todas las fuentes autoalojadas en WOFF2, en su propio servidor.',
  },
  {
    resource: 'reCAPTCHA',
    broken: 'Formularios de contacto que nunca llegan a enviarse. Consultas que se pierden sin dejar rastro.',
    fixed: 'Campos trampa y un antispam que funciona en China, en lugar del widget de Google.',
  },
  {
    resource: 'Google Maps',
    broken: 'Un recuadro gris donde debería aparecer la dirección de sus oficinas.',
    fixed: 'Mapas integrados de AutoNavi (Gaode) o de Baidu Maps.',
  },
  {
    resource: 'Vídeos de YouTube',
    broken: 'Reproductores muertos en todas sus páginas de producto.',
    fixed: 'Vídeo autoalojado o integrado a través de Tencent Video o Youku.',
  },
  {
    resource: 'Gravatar',
    broken: 'Bloques de comentarios y fichas de autor que congelan la página entera.',
    fixed: 'Avatares remotos desactivados e imágenes servidas en local.',
  },
  {
    resource: 'Scripts en CDN',
    broken: 'Un jQuery cargado desde ajax.googleapis.com paraliza todo lo que depende de él.',
    fixed: 'Todos los scripts empaquetados y servidos desde su propio alojamiento.',
  },
  {
    resource: 'Google Analytics',
    broken: 'Ni un dato de visitas, y una petición bloqueada más en cada página.',
    fixed: 'Baidu Tongji o una herramienta autoalojada como Matomo.',
  },
];

const processSteps = [
  {
    title: 'Descubrimiento',
    when: 'Semanas 1-2',
    body: 'Auditamos su web actual desde una conexión de Shanghái, concretamos sus objetivos para el mercado chino y cerramos alcance y presupuesto.',
  },
  {
    title: 'Diseño',
    when: 'Semanas 2-4',
    body: 'Wireframes y diseño visual concebidos para el usuario chino: composiciones más densas, el móvil por delante y el resultado verificado dentro de WeChat.',
  },
  {
    title: 'Desarrollo',
    when: 'Semanas 4-8',
    body: 'Tema y plugins desarrollados sin un solo recurso bloqueado. Cada dependencia queda autoalojada desde el primer commit.',
  },
  {
    title: 'Pruebas de rendimiento en China',
    when: 'Semanas 8-9',
    body: 'Cargamos el sitio desde nodos de Pekín, Shanghái y Cantón, y corregimos cuanto supere los 2 segundos antes de que usted reciba siquiera un enlace de pruebas.',
  },
  {
    title: 'ICP y alojamiento',
    when: 'En paralelo',
    body: 'El expediente ICP se prepara y se presenta mientras configuramos alojamiento y CDN. Todo avanza al ritmo del desarrollo, sin añadir un día al calendario.',
  },
  {
    title: 'Cimientos de SEO en Baidu',
    when: 'Semanas 9-10',
    body: 'Baidu Webmaster Tools, envío del sitemap, mapa de palabras clave en chino y trabajo sobre cada página. Antes del lanzamiento, no como remiendo posterior.',
  },
  {
    title: 'Lanzamiento',
    when: 'Semana 10',
    body: 'Cambio de DNS, precalentamiento de la CDN y una comprobación el mismo día desde conexiones de China continental.',
  },
  {
    title: 'Soporte',
    when: 'Continuo',
    body: 'Actualizaciones, vigilancia e informe mensual dentro de un plan de mantenimiento. La mayoría de nuestros clientes se queda con nosotros durante años.',
  },
];

const alternatives = [
  {
    title: 'WordPress, bien localizado',
    body: 'La opción acertada cuando su equipo ya domina el editor, publica con frecuencia o gestiona contenidos en varios idiomas. Alojado en China y con recursos locales, carga en menos de 2 segundos y Baidu lo indexa sin dificultad.',
    verdict: 'Nuestra opción por defecto para webs de marca con peso editorial.',
  },
  {
    title: 'Solo WeChat o un CMS local',
    body: 'Una cuenta oficial de WeChat cuenta mucho en China, y también construimos para ella. Ahora bien, por sí sola supone alquilarle la audiencia a Tencent, y un CMS local encierra sus contenidos en una plataforma que su central no sabrá manejar.',
    verdict: 'Como complemento de la web, muy útil. Como sustituto, una apuesta arriesgada.',
  },
  {
    title: 'Astro o headless',
    body: 'Cuando manda la velocidad y el contenido apenas cambia, un sitio estático o headless rinde más que WordPress. También los construimos, y los recomendamos cuando el proyecto lo pide.',
    verdict: 'El briefing decide la tecnología. Si WordPress no conviene a su proyecto, se lo diremos en la primera llamada.',
  },
];

const industries = [
  'B2B e industria',
  'Educación y universidades',
  'Hostelería y viajes',
  'Lujo y gran consumo',
  'SaaS y tecnología',
  'Ciencias de la vida',
  'Multinacionales que entran en China',
];

const differentiators = [
  {
    title: 'Probamos donde viven sus visitantes',
    body: 'Cada entrega se comprueba desde conexiones chinas, en Pekín, Shanghái y Cantón. Que el semáforo esté en verde en Fráncfort no significa nada para un visitante de Chengdu.',
  },
  {
    title: 'La ICP, tramitada en mandarín',
    body: 'Nuestro equipo lleva años presentando expedientes ICP directamente ante los proveedores y el MIIT, en mandarín. Usted firma los documentos; del resto nos ocupamos nosotros.',
  },
  {
    title: 'Especialistas en Baidu en plantilla',
    body: 'Palabras clave investigadas en chino, Baidu Webmaster Tools y contenidos redactados por nativos. El mismo equipo que construye su sitio es el que lo hace subir.',
  },
  {
    title: 'Bilingües y con un único interlocutor',
    body: 'Un responsable de cuenta le contesta en español o en inglés en menos de 24 horas, con el equipo de producción de Shanghái detrás. No subcontratamos nunca.',
  },
];

const faqs = [
  {
    id: 'works-in-china',
    q: '¿De verdad funciona WordPress en China?',
    a: 'Sí, siempre que se aloje en China o cerca de ella y se le retiren los recursos bloqueados. El núcleo de WordPress no da ningún problema; los fallos vienen de los temas y plugins que llaman a Google Fonts, reCAPTCHA, Gravatar y otros servicios bloqueados. Hemos entregado más de 50 sitios WordPress que cargan en menos de 2 segundos desde China continental.',
  },
  {
    id: 'icp-needed',
    q: '¿Necesito una licencia ICP para mi sitio WordPress?',
    a: 'Solo si lo aloja en China continental. El registro ICP Bei’an cubre las webs corporativas y de marketing y exige una entidad jurídica china. Vender directamente al consumidor chino desde la web suele requerir la licencia ICP comercial, con requisitos más estrictos. Si no tiene entidad china, el alojamiento en Hong Kong evita la ICP por completo y sigue rindiendo bien.',
  },
  {
    id: 'fix-without-rebuild',
    q: 'Mi sitio WordPress va lento en China. ¿Pueden arreglarlo sin rehacerlo?',
    a: 'Casi siempre, sí. La lentitud obedece casi siempre a dos causas, recursos de terceros bloqueados y un alojamiento demasiado lejano, y ambas se corrigen sin tocar el diseño ni los contenidos. Migramos el sitio a un alojamiento preparado para China, localizamos fuentes y scripts y sustituimos los plugins que fallan. Nuestro escáner gratuito le mostrará exactamente qué está bloqueando el suyo.',
  },
  {
    id: 'timeline',
    q: '¿Cuánto se tarda en lanzar un sitio WordPress en China?',
    a: 'Una web de marca nueva lleva de 8 a 12 semanas desde el arranque hasta el lanzamiento. Migrar y localizar una web global existente lleva de 14 a 20 semanas, incluidas la reescritura de contenidos y la indexación en Baidu. El registro ICP tarda de 2 a 4 semanas y avanza en paralelo al desarrollo.',
  },
  {
    id: 'woocommerce',
    q: '¿Funciona WooCommerce en China?',
    a: 'Sí, con ajustes locales. El pago pasa por WeChat Pay y Alipay en lugar de Stripe o PayPal, y vender en el mercado interno exige la licencia ICP comercial y una entidad china. Muchas marcas extranjeras empiezan por el comercio electrónico transfronterizo, con requisitos más ligeros. Hemos construido ambos modelos.',
  },
  {
    id: 'google-rankings',
    q: '¿Optimizar para China perjudicará mis posiciones en Google en otros mercados?',
    a: 'No. Su web para China convive con su web global, normalmente en un subdominio o un dominio .cn, con etiquetas hreflang que indican a Google y a Baidu qué versión sirve a qué público. Sus posiciones actuales se quedan donde están.',
  },
  {
    id: 'chinese-content',
    q: '¿Se encargan del contenido en chino simplificado y de la configuración multilingüe?',
    a: 'Sí. Trabajamos con WPML y Polylang para WordPress multilingüe, y nuestros redactores chinos nativos producen los contenidos en chino simplificado. Un chino traducido a máquina le suena tan mal a un comprador chino como a usted un español traducido a máquina, así que no lo usamos.',
  },
  {
    id: 'cost',
    q: '¿Cuánto cuesta un proyecto WordPress para China?',
    a: 'Depende del número de páginas, de si necesita registro ICP, del nivel de alojamiento, del volumen de localización y de si hay comercio electrónico. Cerramos un precio fijo tras una llamada de alcance, y tanto la llamada como el presupuesto son gratuitos. El mantenimiento y el alojamiento funcionan después con una cuota mensual fija.',
  },
];

// Esquema Service: ancla la entidad «agencia WordPress en China» para esta página
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: 'Agencia WordPress en China',
  description: 'Agencia WordPress dedicada al mercado chino: diseño, desarrollo, alojamiento a prueba de cortafuegos, licencia ICP, SEO en Baidu, migración y mantenimiento de sitios WordPress en China continental.',
  serviceType: 'Desarrollo WordPress',
  provider: { '@id': `${siteOrigin}/#organization` },
  areaServed: { '@type': 'Country', name: 'China' },
  url: pageUrl,
  inLanguage: 'es-ES',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios WordPress para China',
    itemListElement: services.map((s, i) => ({
      '@type': 'Offer',
      position: i + 1,
      itemOffered: {
        '@type': 'Service',
        name: s.title,
        description: s.body,
        url: `${siteOrigin}${s.href}`,
      },
    })),
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteOrigin}/es/` },
    { '@type': 'ListItem', position: 2, name: 'Agencia WordPress en China', item: pageUrl },
  ],
};
---

<PageLayout
  title={metaTitle}
  description={metaDescription}
  heroPage={true}
  lang="es"
  jsonLd={[serviceLd, faqLd, breadcrumbLd]}
  alternateUrls={{ en: '/wordpress-agency-china/', fr: '/fr/agence-wordpress-chine/', es: '/es/agencia-wordpress-china/', de: '/de/wordpress-agentur-china/' }}
>
  <ScrollEffects />
  <PageScrollEffects />

  <!-- ============= HERO con simulación de red ============= -->
  <section
    data-hero
    class="relative bg-[var(--color-surface-dark)] overflow-hidden flex flex-col"
  >
    <div class="absolute inset-0">
      <img
        src="/images/hero-wordpress-agency-china.webp"
        alt=""
        width="1600"
        height="900"
        class="absolute inset-0 w-full h-full object-cover scale-105 opacity-60"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0e]/97 via-[#0a0a0e]/88 to-[#0a0a0e]/60"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0e]/70 via-transparent to-[#0a0a0e]"></div>
    </div>

    <div aria-hidden="true" class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute top-[8%] -left-32 w-[600px] h-[600px] rounded-full bg-[var(--color-brand-orange)]/[0.16] blur-[140px]"></div>
      <div class="absolute bottom-[5%] right-[15%] w-[500px] h-[500px] rounded-full bg-[#EF4444]/[0.08] blur-[160px]"></div>
    </div>

    <div
      aria-hidden="true"
      class="absolute inset-0 [background-image:radial-gradient(rgba(255,255,255,0.07)_1px,transparent_1px)] [background-size:38px_38px] pointer-events-none"
    ></div>

    <div class="relative z-10 mx-auto w-full max-w-[1240px] section-padding flex-1 pt-32 lg:pt-40 pb-16 lg:pb-24">
      <div class="grid grid-cols-12 gap-10 lg:gap-8 items-center">
        <!-- Izquierda: titular -->
        <div class="col-span-12 lg:col-span-6">
          <div class="flex items-center gap-3 mb-6">
            <div class="h-px w-10 bg-[var(--color-brand-orange)]"></div>
            <span class="text-xs lg:text-sm font-medium tracking-[0.18em] text-[var(--color-brand-orange)] uppercase">
              Especialistas en WordPress · Con sede en Shanghái
            </span>
          </div>

          <h1 class="text-[clamp(2.3rem,4.6vw,3.9rem)] font-medium font-[var(--font-heading)] text-white leading-[1.04] tracking-tight">
            Agencia WordPress en China:
            <span class="block mt-2">
              <span class="bg-gradient-to-r from-[var(--color-brand-orange)] via-[#FF9466] to-[var(--color-brand-orange)] bg-clip-text text-transparent">
                crear, alojar y posicionar
              </span>
            </span>
            <span class="block mt-2 text-white/95">detrás del Gran Cortafuegos.</span>
          </h1>

          <p class="mt-7 text-base lg:text-lg text-white/65 leading-relaxed max-w-[560px]">
            Nuestros sitios WordPress cargan en menos de 2 segundos dentro de China continental. Diseño, desarrollo, alojamiento, licencia ICP y SEO en Baidu: todo lo lleva un mismo equipo desde Shanghái.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-4">
            <Button href="/es/contacto/" variant="primary" size="lg">Solicitar presupuesto</Button>
            <a
              href="/es/china-site-scanner/"
              class="inline-flex items-center gap-2 px-7 py-3 text-base font-medium font-[var(--font-button)] rounded-[var(--radius-pill)] border border-white/20 bg-white/[0.04] backdrop-blur-md text-white hover:bg-white/[0.10] hover:border-white/40 hover:-translate-y-0.5 no-underline transition-all duration-200"
            >
              Auditoría China gratuita
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>

          <div class="mt-12 grid grid-cols-3 gap-6 max-w-xl">
            <div class="border-l-2 border-[var(--color-brand-orange)]/70 pl-4">
              <div class="text-2xl lg:text-3xl font-medium font-[var(--font-heading)] text-white leading-none"><span data-counter data-counter-suffix="+">50</span></div>
              <div class="text-[10px] uppercase tracking-[0.18em] text-white/50 mt-2">Sitios WordPress entregados</div>
            </div>
            <div class="border-l-2 border-white/15 pl-4">
              <div class="text-2xl lg:text-3xl font-medium font-[var(--font-heading)] text-white leading-none"><span data-counter data-counter-suffix="+">15</span></div>
              <div class="text-[10px] uppercase tracking-[0.18em] text-white/50 mt-2">Años en China</div>
            </div>
            <div class="border-l-2 border-white/15 pl-4">
              <div class="text-2xl lg:text-3xl font-medium font-[var(--font-heading)] text-white leading-none">&lt;2s</div>
              <div class="text-[10px] uppercase tracking-[0.18em] text-white/50 mt-2">Carga en grandes ciudades</div>
            </div>
          </div>
        </div>

        <!-- Derecha: simulación de red en directo -->
        <div class="col-span-12 lg:col-span-6" data-reveal="right">
          <div id="net-sim" class="relative max-w-[560px] mx-auto lg:ml-auto rounded-2xl border border-white/12 bg-[#101016]/90 backdrop-blur-md shadow-[0_40px_90px_-30px_rgba(0,0,0,0.8)] overflow-hidden">
            <div class="flex items-center gap-3 px-4 py-3 border-b border-white/10 bg-white/[0.03]">
              <div class="flex gap-1.5" aria-hidden="true">
                <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#FEBC2E]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#28C840]"></span>
              </div>
              <div class="flex-1 flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/[0.06] text-[12px] font-mono text-white/60 truncate">
                <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 3.935"/></svg>
                sumarca.com
              </div>
              <div class="hidden sm:flex items-center gap-1.5 text-[11px] font-mono text-white/50 shrink-0">
                <svg class="w-3.5 h-3.5 text-[var(--color-brand-orange)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Shanghái, CN
              </div>
            </div>

            <div class="h-[3px] bg-white/[0.06]">
              <div id="sim-progress" class="h-full w-0 bg-[#EF4444] transition-none"></div>
            </div>

            <div class="flex items-center justify-between px-4 pt-3.5 pb-1">
              <span id="sim-phase" class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[0.14em] text-white/60">
                <span id="sim-phase-dot" class="w-1.5 h-1.5 rounded-full bg-[#EF4444]"></span>
                <span id="sim-phase-label">Instalación WordPress estándar</span>
              </span>
              <span class="text-[13px] font-mono text-white/80 tabular-nums">
                <span id="sim-timer">0,0</span>&nbsp;s
              </span>
            </div>

            <div id="sim-rows" class="px-4 pb-3 pt-1.5 min-h-[248px] flex flex-col gap-1.5" aria-live="off"></div>

            <div id="sim-verdict" class="mx-4 mb-4 rounded-lg px-3.5 py-2.5 text-[12.5px] font-mono border border-white/10 bg-white/[0.04] text-white/45 transition-colors duration-500">
              Esperando la primera petición...
            </div>
          </div>
          <p class="mt-3 text-center lg:text-right text-[11px] font-mono uppercase tracking-[0.14em] text-white/35">
            Simulación fiel a las auditorías que realizamos a diario
          </p>
        </div>

<script>
  function initDependencyIndexPage() {
    const searchInput = document.getElementById('dep-search') as HTMLInputElement | null;
    const catButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.dep-cat-btn'));
    const verdictButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.dep-verdict-btn'));
    const categoryJumpButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-jump]'));
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-dep-row]'));
    const emptyState = document.getElementById('dep-empty-state');
    const registerSection = document.getElementById('full-register');

    if (!rows.length) return;

    let activeCategory = 'all';
    let activeVerdict = 'all';
    let query = '';

    function applyFilters() {
      let visibleCount = 0;
      const q = query.trim().toLowerCase();

      rows.forEach((row) => {
        const matchCat = activeCategory === 'all' || row.dataset.category === activeCategory;
        const matchVerdict = activeVerdict === 'all' || row.dataset.verdict === activeVerdict;
        const matchSearch = !q || (row.dataset.search ?? '').includes(q);
        const show = matchCat && matchVerdict && matchSearch;
        row.hidden = !show;
        if (show) visibleCount += 1;
      });

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
    }

    function updateCatButtons() {
      catButtons.forEach((btn) => {
        const isCurrent = btn.dataset.catFilter === activeCategory;
        btn.classList.toggle('bg-[var(--color-brand-orange)]', isCurrent);
        btn.classList.toggle('text-white', isCurrent);
        btn.classList.toggle('border-[var(--color-brand-orange)]', isCurrent);
        btn.classList.toggle('bg-white/[0.04]', !isCurrent);
        btn.classList.toggle('text-white/70', !isCurrent);
        btn.classList.toggle('border-white/10', !isCurrent);
      });
    }

    function updateVerdictButtons() {
      verdictButtons.forEach((btn) => {
        const isCurrent = btn.dataset.verdictFilter === activeVerdict;
        btn.classList.toggle('bg-white/15', isCurrent);
        btn.classList.toggle('text-white', isCurrent);
        btn.classList.toggle('border-white/30', isCurrent);
        btn.classList.toggle('bg-white/[0.04]', !isCurrent);
        btn.classList.toggle('text-white/70', !isCurrent);
        btn.classList.toggle('border-white/10', !isCurrent);
      });
    }

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.dataset.catFilter ?? 'all';
        updateCatButtons();
        applyFilters();
      });
    });

    verdictButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeVerdict = btn.dataset.verdictFilter ?? 'all';
        updateVerdictButtons();
        applyFilters();
      });
    });

    categoryJumpButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.dataset.categoryJump ?? 'all';
        updateCatButtons();
        applyFilters();
        registerSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    searchInput?.addEventListener('input', () => {
      query = searchInput.value;
      applyFilters();
    });
  }

  initDependencyIndexPage();
  document.addEventListener('astro:page-load', initDependencyIndexPage);
  document.addEventListener('astro:after-swap', initDependencyIndexPage);
</script>


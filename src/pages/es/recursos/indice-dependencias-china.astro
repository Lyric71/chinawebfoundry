---
/**
 * Índice de dependencias web en China: página central (/es/recursos/indice-dependencias-china/).
 *
 * Explica qué mide el Índice mensual de dependencias web en China, presenta el
 * desglose gráfico por categoría y veredicto junto al registro interactivo de
 * 115 hosts externos, y sigue la evolución mes a mes a partir de los archivos
 * JSON publicados en public/data/china-dependency-index-YYYY-MM.json.
 */
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';
import {
  loadDependencyIndexData,
  VERDICT_META,
  VERDICT_LABELS_BY_LOCALE,
  CATEGORY_LABELS_BY_LOCALE,
  REPORT_ANCHOR_IDS,
  type IndexEntry,
} from '../../../data/dependencyIndex';

const {
  latestPanel,
  latestEdition,
  previousEdition,
  editions,
  verdictSummaries,
  categorySummaries,
  globalTendency,
} = loadDependencyIndexData('es');

const verdictLabels = VERDICT_LABELS_BY_LOCALE.es;
const categoryLabels = CATEGORY_LABELS_BY_LOCALE.es;

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://www.chinawebfoundry.com';

const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${siteOrigin}/es/recursos/indice-dependencias-china/#dataset`,
  name: 'Índice de dependencias web en China',
  description:
    `Registro mensual de ${latestEdition.totalEntries} dependencias web de terceros en 8 categorías, elaborado a partir de los veredictos HTTPS fechados de GreatFire y de las sondas de red de 21YunBox en China continental.`,
  url: `${siteOrigin}/es/recursos/indice-dependencias-china/`,
  inLanguage: 'es-ES',
  isPartOf: { '@id': `${siteOrigin}/#website` },
  publisher: { '@id': `${siteOrigin}/#organization` },
  dateModified: latestEdition.compiledOn,
  distribution: editions.map((ed) => ({
    '@type': 'DataDownload',
    name: `Índice de dependencias web en China ${ed.label} (${ed.edition}) JSON`,
    encodingFormat: 'application/json',
    contentUrl: `${siteOrigin}${ed.jsonPath}`,
  })),
};

function formatCloudCell(row: IndexEntry): { primary: string; sub: string | null } {
  if (row.dc_n && row.dc_ms !== null) {
    return {
      primary: `${row.dc_n} respuestas`,
      sub: `TTFB mediano: ${row.dc_ms} ms (${row.dc_date})`,
    };
  }
  if (row.dc_n) {
    return { primary: `${row.dc_n} respuestas`, sub: row.dc_date ? `Medido el ${row.dc_date}` : null };
  }
  return { primary: 'No disponible', sub: 'Sin sonda cloud identificada' };
}

function formatHomeCell(row: IndexEntry): { primary: string; sub: string | null } {
  if (row.consumer_n && row.consumer_ms !== null) {
    return {
      primary: `${row.consumer_n} respuestas`,
      sub: `TTFB mediano: ${row.consumer_ms} ms (${row.consumer_date})`,
    };
  }
  if (row.consumer_n) {
    return {
      primary: `${row.consumer_n} respuestas`,
      sub: row.consumer_date ? `Línea residencial Pekín (${row.consumer_date})` : null,
    };
  }
  return { primary: 'No disponible', sub: 'Sin medición residencial identificada' };
}

function translateGfVerdict(raw: string): string {
  return raw
    .replace(/^Blocked\b/i, 'Bloqueado')
    .replace(/^Reachable\b/i, 'Accesible')
    .replace(/^Contradictory\b/i, 'Contradictorio')
    .replace(/^Intermittent\b/i, 'Intermitente');
}

function formatGreatFireCell(row: IndexEntry): { primary: string; sub: string | null } {
  if (!row.gf_verdict) {
    return { primary: 'No disponible', sub: 'Sin muestra en GreatFire' };
  }
  const parts: string[] = [];
  if (row.gf_count) parts.push(`${row.gf_count} comprobaciones`);
  if (row.gf_date) parts.push(row.gf_date);
  return {
    primary: translateGfVerdict(row.gf_verdict),
    sub: parts.length ? parts.join(' · ') : null,
  };
}

function formatChangeBadge(change: string): { label: string; badgeClass: string } {
  switch (change) {
    case 'improved':
      return { label: '↑ Mejora', badgeClass: 'text-emerald-400' };
    case 'degraded':
      return { label: '↓ Empeora', badgeClass: 'text-rose-400' };
    case 'newlyTested':
      return { label: '★ Recién probado', badgeClass: 'text-amber-300' };
    case 'withdrawn':
      return { label: '− Medición retirada', badgeClass: 'text-white/55' };
    case 'unchanged':
      return { label: '→ Sin cambios', badgeClass: 'text-white/45' };
    default:
      return { label: change, badgeClass: 'text-white/55' };
  }
}

const methodCards = [
  {
    eyebrow: 'Puntos de medición · 测量点',
    title: 'Sonda cloud frente a banda ancha doméstica',
    body: 'El 28 de agosto de 2026, 21YunBox muestreó cinco recursos cada diez minutos durante doce horas desde el centro de datos Alibaba Cloud (阿里云) cn-zhangjiakou (límite de 30 segundos) y, el 30 de agosto de 2026, observó 264 cargas de página en 88 sitios desde una línea doméstica de China Mobile (中国移动) en Pekín (tope de 60 segundos). Solo uno quedó sin respuesta desde la nube; cuatro callaron en la línea residencial pekinesa.',
  },
  {
    eyebrow: 'Objetivos acotados · 测试目标',
    title: 'Nombres de host exactos y fechas de prueba',
    body: 'Cada fila consigna el nombre de host o la ruta de URL exacta sometida a prueba, como fonts.googleapis.com, www.googletagmanager.com o challenges.cloudflare.com, junto con la fecha del corte original. Los veredictos HTTPS de GreatFire ocupan su propia columna porque GreatFire no detalla la región cloud ni el operador doméstico empleado.',
  },
  {
    eyebrow: 'Lagunas explícitas · 证据边界',
    title: 'Lo no medido figura como «sin probar»',
    body: 'Veintiuna entradas de este registro de 115 hosts carecen de pruebas fechadas de terceros, entre ellas js.driftt.com, js.hs-scripts.com, cdn.matomo.cloud, Crisp y Tawk.to. En lugar de atribuirles un veredicto por aproximación, las mantenemos como «sin probar» hasta que exista una medición fechada.',
  },
];

const evolutionRules = [
  {
    eyebrow: 'Mismos puntos de destino',
    title: 'Variaciones comparables',
    body: 'Una fila solo cambia en la columna de evolución mensual cuando la misma fuente vuelve a probar el mismo nombre de host y protocolo en una fecha posterior.',
  },
  {
    eyebrow: 'Cobertura frente a red',
    title: 'Cambios de método por separado',
    body: 'Releer una fuente verifica la cita pero no equivale a una prueba nueva. La retirada de tiempos en fichas de proveedor o los ajustes de criterio se anotan aparte.',
  },
  {
    eyebrow: 'Cortes permanentes',
    title: 'URL fechadas y JSON descargable',
    body: 'Cada edición mensual conserva su propia dirección y su manifiesto JSON en bruto (/data/china-dependency-index-YYYY-MM.json) para que cualquier referencia pasada siga siendo comprobable.',
  },
];
---

<PageLayout
  title="Índice de dependencias web en China: 115 hosts"
  description="Registro mensual de 115 hosts externos en China (GreatFire, 21YunBox). En octubre de 2026, el 48,9% de los probados son accesibles (+24,5% vs sep.)."
  heroPage={true}
  breadcrumbName="Índice de dependencias web en China"
  jsonLd={[datasetLd]}
>
  <!-- ====== HERO ====== -->
  <section class="cdi-hero relative bg-[#0a0a0e] overflow-hidden min-h-[100svh] flex flex-col justify-center pt-[68px] sm:pt-[76px] lg:pt-[80px] pb-4 lg:pb-6">
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
      <div class="absolute inset-0 bg-gradient-to-br from-[#1a1a2e]/70 via-[#0a0a0e] to-[#0f0f12]"></div>
      <div class="absolute inset-0 [background-image:radial-gradient(rgba(255,255,255,0.06)_1px,transparent_1px)] [background-size:38px_38px] opacity-50"></div>
      <div class="absolute -top-32 left-[8%] w-[520px] h-[520px] rounded-full bg-[var(--color-brand-orange)]/[0.12] blur-[150px]"></div>
      <div class="absolute -bottom-32 right-[8%] w-[480px] h-[480px] rounded-full bg-[#3b82f6]/[0.08] blur-[160px]"></div>
      <span class="absolute right-[-3rem] top-[12%] text-[20rem] lg:text-[26rem] font-medium font-[var(--font-heading)] text-white/[0.025] leading-none select-none hidden md:block">
        指数
      </span>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-[1400px] section-padding">
      <div class="grid grid-cols-12 gap-5 lg:gap-8 items-center">
        <!-- Izquierda: titular y presentación -->
        <div class="col-span-12 lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[var(--color-brand-orange)]/15 border border-[var(--color-brand-orange)]/30 mb-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-brand-orange)] animate-pulse"></span>
            <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--color-brand-orange)]">
              Índice de dependencias web en China · 依赖指数
            </span>
          </div>

          <h1 class="text-[clamp(1.7rem,3.6vw,3.1rem)] font-medium font-[var(--font-heading)] text-white leading-[1.04]">
            {latestEdition.totalEntries} dependencias web.
            <span class="block mt-0.5">
              <span class="bg-gradient-to-r from-[var(--color-brand-orange)] via-[#FF9466] to-[var(--color-brand-orange)] bg-clip-text text-transparent">
                Medidas desde China.
              </span>
            </span>
            <span class="block mt-0.5 text-white/95">Actualizadas cada mes.</span>
          </h1>

          <p class="mt-2.5 sm:mt-3 text-xs sm:text-sm lg:text-[15px] text-white/70 leading-snug max-w-2xl">
            Cuando una web extranjera se atasca en China continental, rara vez falla su servidor de origen: suelen ser los hosts externos que la página invoca al abrirse, desde Google Fonts y gestores de etiquetas hasta widgets de captcha, scripts de formularios, reproductores de vídeo o API de búsqueda. Nuestro Índice de dependencias web en China sigue cada mes {latestEdition.totalEntries} recursos de terceros en 8 categorías a partir de los veredictos HTTPS fechados de GreatFire y de las sondas de red de 21YunBox.
          </p>
          <p class="mt-2 text-xs sm:text-sm text-white/55 leading-snug max-w-2xl">
            Recopilamos lo que publican GreatFire y 21YunBox, separamos los tiempos medidos desde el centro de datos de Alibaba Cloud (阿里云) de las observaciones en una línea residencial de China Mobile (中国移动) en Pekín, y anotamos cómo varía cada fila mes a mes. No operamos sondas propias en China continental.
          </p>

          <div class="mt-3.5 sm:mt-4 flex flex-wrap items-center gap-2.5">
            <Button href="#full-register" variant="primary" size="md">
              Explorar el registro de {latestEdition.totalEntries} hosts
            </Button>
            <a
              href={latestEdition.slug}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/20 bg-white/[0.04] text-xs sm:text-sm font-medium font-[var(--font-button)] text-white hover:border-[var(--color-brand-orange)] hover:bg-white/[0.08] no-underline transition-all duration-200"
            >
              Leer el informe de {latestEdition.label}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a
              href="#evolution-log"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono text-white/65 hover:text-white no-underline transition-colors"
            >
              Ver evolución mensual ↓
            </a>
          </div>
        </div>

        <!-- Derecha: tarjeta gráfica de la edición actual -->
        <div class="col-span-12 lg:col-span-5">
          <div class="rounded-3xl bg-white/[0.04] backdrop-blur-md border border-white/10 p-4 lg:p-5">
            <div class="flex items-start justify-between gap-3 pb-2.5 mb-2.5 border-b border-white/10">
              <div>
                <div class="text-[10px] font-mono uppercase tracking-[0.16em] text-white/55">
                  Edición actual · Compilada el {latestEdition.compiledLabel}
                </div>
                <div class="text-lg sm:text-xl font-medium font-[var(--font-heading)] text-white mt-0.5 capitalize">
                  {latestEdition.label}
                </div>
                <div class="text-[10px] font-mono text-white/50 mt-0.5">
                  Ventana de muestras: {latestEdition.sourceWindow}
                </div>
              </div>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-400/30 flex-shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-[10px] font-mono uppercase tracking-wider text-emerald-300">
                  Edición {latestEdition.edition}
                </span>
              </span>
            </div>

            <!-- Gran banda de tendencia global -->
            <div class="rounded-2xl bg-gradient-to-r from-emerald-500/[0.10] via-white/[0.04] to-white/[0.02] border border-emerald-400/25 p-3 mb-2.5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <div class="text-[10px] font-mono uppercase tracking-[0.16em] text-emerald-300/90">
                    Índice global de accesibilidad · 整体可达率
                  </div>
                  <div class="flex items-baseline gap-2 mt-0.5">
                    <span class="text-2xl sm:text-3xl font-mono font-bold text-white leading-none tracking-tight">
                      {globalTendency.reachabilityPct}
                    </span>
                    <span class="text-[11px] font-mono text-white/65">
                      accesibles ({globalTendency.reachableCount}/{globalTendency.testedCount} probados)
                    </span>
                  </div>
                </div>
                <div class="flex flex-col items-end">
                  <span
                    class:list={[
                      'inline-flex items-center gap-1 px-2.5 py-1 rounded-xl border font-mono text-xs sm:text-sm font-bold leading-none',
                      globalTendency.trendBadgeClass,
                    ]}
                  >
                    <span>{globalTendency.trendArrow}</span>
                    <span>{globalTendency.deltaPct}</span>
                  </span>
                  <span class="text-[10px] font-mono text-white/50 mt-0.5">
                    {globalTendency.comparisonLabel} ({globalTendency.prevReachabilityPct})
                  </span>
                </div>
              </div>
            </div>

            <!-- Barra de distribución de veredictos -->
            <div class="mb-2">
              <div class="flex items-center justify-between text-[11px] text-white/55 mb-1">
                <span>Distribución del registro ({latestEdition.totalEntries} entradas)</span>
                <span class="font-mono text-[10px]">{categorySummaries.length} categorías</span>
              </div>
              <div
                class="flex h-2 w-full rounded-full overflow-hidden bg-white/[0.06] gap-0.5 p-0.5"
                role="img"
                aria-label={`Distribución de las ${latestEdition.totalEntries} dependencias según veredicto`}
              >
                {verdictSummaries.map((v) => (
                  <div
                    class:list={['h-full first:rounded-l-full last:rounded-r-full', v.barClass]}
                    style={`width: ${(v.count / latestEdition.totalEntries) * 100}%`}
                    title={`${v.label}: ${v.count} entradas`}
                  ></div>
                ))}
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-1 pt-0.5">
              {verdictSummaries.map((v) => (
                <div class="flex items-center justify-between gap-2 rounded-xl bg-white/[0.03] border border-white/5 px-2.5 py-1">
                  <span class="inline-flex items-center gap-1.5 text-[11px] text-white/75 truncate">
                    <span class:list={['w-1.5 h-1.5 rounded-full flex-shrink-0', v.dotClass]}></span>
                    <span class="truncate">{v.label}</span>
                  </span>
                  <span class="inline-flex items-center gap-1 flex-shrink-0 font-mono">
                    <span class="text-[11px] font-semibold text-white">{v.count}</span>
                    <span
                      class:list={['text-[10px] font-medium px-1 py-0.5 rounded bg-white/[0.04]', v.trendClass]}
                      title={`Frente a ${previousEdition.label}: ${v.prevCount} → ${v.count}`}
                    >
                      {v.trendArrow} {v.trendText}
                    </span>
                  </span>
                </div>
              ))}
            </div>

            <div class="mt-2.5 pt-2 border-t border-white/10 flex items-center justify-between text-[11px] text-white/55">
              <span>Cada fila respeta el método de su fuente</span>
              <a
                href={latestEdition.jsonPath}
                class="font-mono text-[var(--color-brand-orange)] hover:text-[#FF9466] no-underline"
              >
                Descargar JSON ↓
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== QUÉ MIDE EL ÍNDICE Y METODOLOGÍA ====== -->
  <section class="py-20 md:py-28 bg-[var(--color-surface-light)] border-b border-[var(--color-surface-border)]">
    <div class="mx-auto max-w-[1400px] section-padding">
      <div class="max-w-3xl mb-12 lg:mb-14">
        <p class="text-xs font-mono uppercase tracking-[0.18em] text-[var(--color-brand-orange-text)] mb-3">
          Qué mide el índice · 指数说明
        </p>
        <h2 class="text-3xl sm:text-4xl font-medium font-[var(--font-heading)] text-[var(--color-text-dark)] leading-tight mb-4">
          Por qué no mezclamos sondas cloud, banda ancha residencial en Pekín y pruebas de GreatFire
        </h2>
        <p class="text-base lg:text-lg text-[var(--color-text-body)] leading-relaxed mb-4">
          Que un servidor responda al instante desde un centro de datos de Alibaba Cloud (阿里云) no impide que la página se quede colgada en el navegador de un usuario cuando intenta cargar un host externo bloqueado. Cada fuente pública mide desde un punto distinto de la red y aplica sus propios tiempos de espera: por eso nuestro registro mantiene esas columnas por separado en lugar de fundirlas en una media artificial.
        </p>
        <p class="text-sm lg:text-base text-[var(--color-text-body)] leading-relaxed">
          En octubre de 2026, {globalTendency.reachableCount} de los {globalTendency.testedCount} hosts probados ({globalTendency.reachabilityPct}) figuran como accesibles, frente a los {globalTendency.prevReachableCount} de {globalTendency.prevTestedCount} ({globalTendency.prevReachabilityPct}) de septiembre de 2026. Buena parte de ese salto de {globalTendency.deltaPct} obedece al cambio de criterio que GreatFire introdujo a finales de agosto de 2026, al dejar de contabilizar como bloqueo las conexiones rechazadas sin más rastro de interferencia en China continental, unido a la retirada por parte de 21YunBox, el 7 de octubre de 2026, de 11 mediciones en páginas de proveedor y a la incorporación de 12 hosts con primera prueba fechada. Cuando una dependencia falla en sus propias páginas, nuestra guía de <a href="/es/recursos/guia-web-china/cdn-javascript-china/" class="text-[var(--color-brand-orange-text)] underline">CDN de JavaScript en China</a>, nuestra <a href="/es/recursos/guia-web-china/gran-cortafuegos-china/" class="text-[var(--color-brand-orange-text)] underline">tabla de compatibilidad frente al Gran Cortafuegos</a> y nuestro equipo de <a href="/es/servicios/integracion-tecnica/" class="text-[var(--color-brand-orange-text)] underline">integración técnica</a> en Shanghái detallan los recambios posibles.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-10">
        <blockquote class="rounded-2xl bg-white border-l-4 border-[var(--color-brand-orange)] border border-[var(--color-surface-border)] p-6 shadow-sm">
          <p class="text-sm text-[var(--color-text-dark)] leading-relaxed">
            «De los cinco recursos analizados en el estudio pareado de 21YunBox, solo reCAPTCHA quedó sin respuesta desde Alibaba Cloud (阿里云) cn-zhangjiakou el 28 de agosto de 2026. En la banda ancha residencial de China Mobile (中国移动) en Pekín, el 30 de agosto de 2026, tampoco respondieron los dos hosts de Google Fonts ni Google Tag Manager. jsDelivr respondió desde ambos puntos.»
          </p>
          <footer class="mt-3 text-xs font-mono text-[var(--color-text-muted)]">
            Fuente: 21YunBox, 28 y 30 de agosto de 2026 · <a href="https://www.21cloudbox.com/a-day-of-third-party-requests-from-inside-china.html" target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--color-brand-orange-text)]">21cloudbox.com</a>
          </footer>
        </blockquote>
        <blockquote class="rounded-2xl bg-white border-l-4 border-[var(--color-brand-orange)] border border-[var(--color-surface-border)] p-6 shadow-sm">
          <p class="text-sm text-[var(--color-text-dark)] leading-relaxed">
            «Desde finales de agosto de 2026 se vienen registrando rechazos de conexión en rutas sin ningún otro indicio de interferencia, por lo que ya no se contabilizan como prueba de bloqueo.»
          </p>
          <footer class="mt-3 text-xs font-mono text-[var(--color-text-muted)]">
            Fuente: notas de revisión de veredictos HTTPS de GreatFire, septiembre y octubre de 2026 · <a href="https://en.greatfire.org/https/cdn.shopify.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--color-brand-orange-text)]">en.greatfire.org</a>
          </footer>
        </blockquote>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {methodCards.map((card) => (
          <article class="rounded-2xl bg-white border border-[var(--color-surface-border)] p-7 lg:p-8 shadow-sm">
            <p class="text-xs font-mono uppercase tracking-[0.16em] text-[var(--color-brand-orange-text)] mb-3">
              {card.eyebrow}
            </p>
            <h3 class="text-xl font-medium font-[var(--font-heading)] text-[var(--color-text-dark)] leading-snug mb-3">
              {card.title}
            </h3>
            <p class="text-sm text-[var(--color-text-body)] leading-relaxed">
              {card.body}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== DESGLOSE GRÁFICO POR CATEGORÍA ====== -->
  <section class="py-20 md:py-24 bg-[#0a0a0e] text-white border-b border-white/10">
    <div class="mx-auto max-w-[1400px] section-padding">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-12">
        <div>
          <p class="text-xs font-mono uppercase tracking-[0.18em] text-[var(--color-brand-orange)] mb-3">
            Desglose por categoría · 分类视图
          </p>
          <h2 class="text-3xl sm:text-4xl font-medium font-[var(--font-heading)] text-white leading-tight">
            Cómo se reparten las {latestEdition.totalEntries} dependencias en {categorySummaries.length} categorías
          </h2>
        </div>
        <p class="text-sm text-white/60 max-w-md">
          Pulse en cualquier tarjeta para filtrar directamente el registro de {latestEdition.label} por esa familia.
        </p>
      </div>


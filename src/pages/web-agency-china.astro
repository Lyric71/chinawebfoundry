---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
import ScrollEffects from '../components/global/ScrollEffects.astro';
import PageScrollEffects from '../components/pages/ScrollEffects.astro';
import { getCollection } from 'astro:content';

const metaTitle = 'Web agency in Shanghai for brands in China | ChinaWebFoundry';
const metaDescription = 'Web agency based in Shanghai. We plan, build, grow and run websites in China for international brands. 15+ years on the ground, 50+ projects, in-house team.';
const canonicalPath = '/web-agency-china/';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const casestudies = (await getCollection('casestudies'))
  .filter((cs) => cs.data.published)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://www.chinawebfoundry.com';
const pageUrl = `${siteOrigin}${canonicalPath}`;
const updatedAt = '2026-10-21';
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  dateModified: updatedAt,
};


// Service schema reinforcing the "web agency in China" entity for this page
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: 'Web agency in China',
  description: 'Full-service web agency for international brands launching and running websites in mainland China. Strategy, content, design, build, Baidu SEO, AI search, hosting and maintenance.',
  serviceType: 'Web agency',
  provider: { '@id': `${siteOrigin}/#organization` },
  areaServed: { '@type': 'Country', name: 'China' },
  url: pageUrl,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: services.map((s, i) => ({
      '@type': 'Offer',
      position: i + 1,
      itemOffered: {
        '@type': 'Service',
        name: s.data.title,
        description: s.data.description,
        url: `${siteOrigin}/services/${s.id}/`,
      },
    })),
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Web agency in China', item: pageUrl },
  ],
};

const differentiators = [
  {
    cn: '驻',
    label: 'On the ground',
    title: 'We live in the market we serve',
    body: 'Our leadership team has been in Shanghai for 15+ years. We open your site in WeChat on a Chinese phone every morning, file ICPs in Mandarin, and answer the questions HQ never thought to ask.',
  },
  {
    cn: '栈',
    label: 'Stack agnostic',
    title: 'Pick the stack per project',
    body: 'WordPress suits teams using its editor and plugin workflow. Astro can prepare pages at build time. A headless setup can share content across sites. The publishing workflow decides the choice.',
  },
  {
    cn: '深',
    label: 'China-specific depth',
    title: 'Built for Baidu, WeChat and the Firewall',
    body: 'Review the site inside WeChat (微信), check its external requests and plan its Baidu (百度) search work. Fonts and other outside services need dated, host-specific evidence. We include those checks in the brief.',
  },
  {
    cn: '端',
    label: 'End to end',
    title: 'One contract, one team, four phases',
    body: 'Plan, build, grow, run. The same people handle strategy, copy, design, code, hosting, Baidu SEO and Chinese AI engine visibility. One invoice, one point of contact, every step of the way.',
  },
];

const faqs = [
  {
    "q": "What should we send before asking for a proposal?",
    "a": "Start with your current URL and what a visitor needs to do on the site. We’ll also need to know who approves Chinese content, whether a mainland entity exists and which systems the site must use before agreeing a launch. Our guide to choosing a web agency in China explains how to compare the resulting scope.",
    "linkText": "choosing a web agency in China",
    "href": "/resources/china-web-guide/choosing-web-agency-china/",
    "source": "",
    "sourceHref": ""
  },
  {
    "q": "Can you work with our existing global agency?",
    "a": "Yes. Agree who owns each part of delivery before work starts. Your global agency can keep the brand system and source content while the Shanghai team handles the China website scope. Record who approves designs, manages hosting access and accepts the finished site. Our website-in-China page sets out the work to include.",
    "linkText": "website-in-China page",
    "href": "/website-in-china/",
    "source": "",
    "sourceHref": ""
  },
  {
    "q": "How does ICP filing affect the launch date?",
    "a": "Alibaba Cloud (阿里云) publishes an initial review of 1 to 2 working days, followed by provincial review generally taking 1 to 20 working days. Document preparation and corrections take additional time. For a mainland launch, agree the build schedule around the ICP filing (ICP备案) approval. The review windows are not a delivery guarantee.",
    "href": "",
    "linkText": "",
    "source": "Source: Alibaba Cloud (阿里云), ICP filing overview, 26 August 2026.",
    "sourceHref": "https://help.aliyun.com/zh/icp-filing/basic-icp-service/user-guide/icp-filing-application-overview"
  },
  {
    "q": "How do we choose between WordPress and Astro?",
    "a": "Start with how your team publishes. WordPress suits teams that want its editor and plugin workflow. Astro can suit sites whose pages are prepared at build time. Both need a review of external requests and hosting. Our WordPress plugin guide explains why the chosen integrations matter as much as the CMS name.",
    "linkText": "WordPress plugin guide",
    "href": "/resources/china-web-guide/wordpress-plugins-china/",
    "source": "",
    "sourceHref": ""
  },
  {
    "q": "How will you price the work?",
    "a": "The proposal should separate the build from ongoing hosting and support. Chinese content can account for substantial work, so establish who supplies and approves it. List the templates and integrations that the quote covers, with a process for approving changes. Separate recurring costs make proposals easier to compare.",
    "href": "",
    "linkText": "",
    "source": "",
    "sourceHref": ""
  }
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

---

<PageLayout
  title={metaTitle}
  description={metaDescription}
  heroPage={true}
  jsonLd={[pageLd, serviceLd, breadcrumbLd, faqLd]}
  alternateUrls={{ en: '/web-agency-china/', fr: '/fr/agence-web-chine/', es: '/es/agencia-web-china/' }}
>
  <ScrollEffects />
  <PageScrollEffects />

  <!-- ============= HERO ============= -->
  <section
    data-hero
    class="relative bg-[var(--color-surface-dark)] overflow-hidden min-h-[88vh] flex flex-col"
  >
    <!-- Background -->
    <div class="absolute inset-0">
      <img
        src="/images/hero-wordpress-china-skyline.webp"
        alt=""
        width="1600"
        height="900"
        class="absolute inset-0 w-full h-full object-cover scale-105"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0e]/95 via-[#0a0a0e]/80 to-[#0a0a0e]/40"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0e]/60 via-transparent to-[#0a0a0e]/95"></div>
    </div>

    <!-- Mesh orbs -->
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute top-[10%] -left-32 w-[600px] h-[600px] rounded-full bg-[var(--color-brand-orange)]/[0.18] blur-[140px]"></div>
      <div class="absolute bottom-[5%] -right-20 w-[500px] h-[500px] rounded-full bg-[#FF7E47]/[0.12] blur-[160px]"></div>
    </div>

    <!-- Dot grid -->
    <div
      aria-hidden="true"
      class="absolute inset-0 [background-image:radial-gradient(rgba(255,255,255,0.08)_1px,transparent_1px)] [background-size:38px_38px] pointer-events-none"
    ></div>

    <!-- Decorative giant glyph -->
    <span
      aria-hidden="true"
      class="absolute right-[-4rem] bottom-[-2rem] text-[26rem] lg:text-[32rem] font-medium font-[var(--font-heading)] text-white/[0.025] leading-none select-none pointer-events-none hidden md:block"
    >中</span>

    <!-- Main content -->
    <div class="relative z-10 mx-auto w-full max-w-[1200px] section-padding flex-1 flex items-center pt-32 lg:pt-40 pb-20 lg:pb-28">
      <div class="max-w-[860px]">
        <!-- Eyebrow -->
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-10 bg-[var(--color-brand-orange)]"></div>
          <span class="text-xs lg:text-sm font-medium tracking-[0.18em] text-[var(--color-brand-orange)] uppercase">
            Web agency in China · Based in Shanghai
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-[clamp(2.4rem,5.2vw,4.5rem)] font-medium font-[var(--font-heading)] text-white leading-[1.02] tracking-tight">
          The web agency
          <span class="block mt-2">
            <span class="bg-gradient-to-r from-[var(--color-brand-orange)] via-[#FF9466] to-[var(--color-brand-orange)] bg-clip-text text-transparent">
              in China
            </span>
          </span>
          <span class="block mt-2 text-white/95">for international brands.</span>
        </h1>

        <p class="mt-7 text-base lg:text-xl text-white/65 leading-relaxed max-w-[700px]">
          We are an independent web agency based in Shanghai. We plan, build, grow and run websites in mainland China for foreign brands. 15+ years on the ground, 50+ projects shipped, every service in-house.
        </p>

        <!-- CTAs -->
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <Button href="/contact/" variant="primary" size="lg">Talk to our team</Button>
          <a
            href="/services/"
            class="inline-flex items-center gap-2 px-7 py-3 text-base font-medium font-[var(--font-button)] rounded-[var(--radius-pill)] border border-white/20 bg-white/[0.04] backdrop-blur-md text-white hover:bg-white/[0.10] hover:border-white/40 hover:-translate-y-0.5 no-underline transition-all duration-200"
          >
            Browse our 10 services
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <!-- Stats strip -->
        <div class="mt-14 grid grid-cols-3 gap-6 max-w-2xl">
          <div class="border-l-2 border-[var(--color-brand-orange)]/70 pl-4">
            <div class="text-2xl lg:text-3xl font-medium font-[var(--font-heading)] text-white leading-none"><span data-counter data-counter-suffix="+">15</span></div>
            <div class="text-[10px] uppercase tracking-[0.18em] text-white/50 mt-2">Years on the ground</div>
          </div>
          <div class="border-l-2 border-white/15 pl-4">
            <div class="text-2xl lg:text-3xl font-medium font-[var(--font-heading)] text-white leading-none"><span data-counter data-counter-suffix="+">50</span></div>
            <div class="text-[10px] uppercase tracking-[0.18em] text-white/50 mt-2">Brand sites shipped</div>
          </div>
          <div class="border-l-2 border-white/15 pl-4">
            <div class="text-2xl lg:text-3xl font-medium font-[var(--font-heading)] text-white leading-none"><span data-counter>10</span></div>
            <div class="text-[10px] uppercase tracking-[0.18em] text-white/50 mt-2">In-house services</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============= WHAT WE ARE / DIFFERENTIATORS ============= -->
  <section class="relative section-spacing bg-white overflow-hidden">
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-32 right-[8%] w-[500px] h-[500px] rounded-full bg-[var(--color-brand-orange)]/[0.06] blur-[140px]"></div>
      <div class="absolute inset-0 [background-image:radial-gradient(var(--color-text-dark)_1px,transparent_1px)] [background-size:34px_34px] opacity-[0.035]"></div>
    </div>

    <div class="relative mx-auto max-w-[1200px] section-padding">
      <div class="max-w-3xl mb-14 lg:mb-16" data-reveal>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-brand-orange)]/10 border border-[var(--color-brand-orange)]/20 mb-5">
          <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[var(--color-brand-orange)]">What kind of web agency · 哪种代理</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-[52px] font-medium font-[var(--font-heading)] text-[var(--color-text-dark)] leading-[1.08] mb-6">
          What a real China web agency looks like.
        </h2>
        <div data-agency-evidence="0" class="my-6 max-w-3xl text-[var(--color-text-body)]">
          <p class="text-base leading-relaxed">Your global site needs a separate review for China. Chinafy’s vendor benchmark gives a reason to check the full page, including its outside requests, before choosing hosting or setting a launch date.</p>
          <blockquote class="mt-3 border-l-2 border-[var(--color-brand-orange)] pl-4 text-sm leading-relaxed"><a href="https://www.chinafy.com/blog/china-website-performance-benchmarks-2026" class="underline underline-offset-4">Chinafy tested 614 global websites with WebPageTest from Beijing, Virginia and London and reported that 2 in 3 failed to load from Beijing. Source: Chinafy, China Website Performance Benchmarks 2026, 14 April 2026. This is a vendor benchmark, with no WordPress-only breakdown.</a></blockquote>
        </div>
        <p class="text-lg text-[var(--color-text-body)] leading-relaxed">
          Four things make our work in China different from work shipped out of London, Paris or New York. All four are operational, none are marketing copy.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-6">
        {differentiators.map((d) => (
          <article
            data-reveal
            class="group relative rounded-3xl border border-[var(--color-surface-border)] bg-white p-7 lg:p-9 overflow-hidden transition-all duration-500 hover:border-[var(--color-brand-orange)]/30 hover:shadow-[0_30px_60px_-25px_rgba(15,15,18,0.18)] hover:-translate-y-1"
          >
            <span aria-hidden="true" class="absolute right-[-1rem] bottom-[-2rem] text-[12rem] font-medium font-[var(--font-heading)] text-[var(--color-brand-orange)]/[0.05] leading-none select-none pointer-events-none transition-transform duration-700 group-hover:scale-110 origin-bottom-right">{d.cn}</span>
            <div class="relative">
              <div class="text-[10px] font-mono uppercase tracking-[0.18em] text-[var(--color-brand-orange)] mb-3">{d.label}</div>
              <h3 class="text-xl lg:text-2xl font-medium font-[var(--font-heading)] text-[var(--color-text-dark)] leading-tight mb-4">{d.title}</h3>
              <p class="text-[15px] lg:text-base text-[var(--color-text-body)] leading-relaxed">{d.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============= OUR 10 SERVICES ============= -->
  <section class="relative section-spacing bg-[var(--color-surface-light)] overflow-hidden">
    <span aria-hidden="true" class="absolute right-[-3rem] top-[8%] text-[20rem] lg:text-[26rem] font-medium font-[var(--font-heading)] text-[var(--color-brand-orange)]/[0.04] leading-none select-none pointer-events-none hidden md:block">服务</span>
    <div class="relative mx-auto max-w-[1200px] section-padding">
      <div class="grid grid-cols-12 gap-8 mb-14 lg:mb-16 items-end">
        <div class="col-span-12 lg:col-span-8" data-reveal>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-brand-orange)]/10 border border-[var(--color-brand-orange)]/20 mb-5">
            <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[var(--color-brand-orange)]">Our services · 服务</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-medium font-[var(--font-heading)] text-[var(--color-text-dark)] leading-[1.1] mb-5">
            10 services. One web agency. Every step of your China web presence.
          </h2>
        <div data-agency-evidence="1" class="my-6 max-w-3xl text-[var(--color-text-body)]">
          <p class="text-base leading-relaxed">Use the service list to divide the brief into work you need before launch and work that continues afterwards. Hosting and maintenance need an owner after the build ends.</p>
          <blockquote class="mt-3 border-l-2 border-[var(--color-brand-orange)] pl-4 text-sm leading-relaxed"><a href="/services/" class="underline underline-offset-4">ChinaWebFoundry lists 10 services, including China Hosting and Maintenance and Support. Source: ChinaWebFoundry service catalogue, checked 21 October 2026.</a></blockquote>
        </div>
          <p class="text-lg text-[var(--color-text-body)] leading-relaxed max-w-2xl">
            Strategy, content, design, build, search, AI visibility, hosting, maintenance. Every service delivered by the same people, in-house, in Shanghai.
          </p>
        </div>
        <div class="col-span-12 lg:col-span-4 lg:text-right" data-reveal data-reveal-delay="120">
          <a href="/services/" class="inline-flex items-center gap-2 text-base font-medium font-[var(--font-button)] text-[var(--color-brand-orange-text)] no-underline hover:gap-3 transition-all">
            See all services in detail
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-5">
        {services.map((s) => (
          <a
            href={`/services/${s.id}/`}
            data-reveal
            class="group relative rounded-2xl bg-white border border-[var(--color-surface-border)] p-6 lg:p-7 no-underline transition-all duration-300 hover:border-[var(--color-brand-orange)]/30 hover:shadow-[0_22px_45px_-22px_rgba(15,15,18,0.15)] hover:-translate-y-1"
          >
            <h3 class="text-lg lg:text-xl font-medium font-[var(--font-heading)] text-[var(--color-text-dark)] leading-tight mb-3 transition-colors duration-200 group-hover:text-[var(--color-brand-orange)]">
              {s.data.title}
            </h3>
            <p class="text-[14px] text-[var(--color-text-body)] leading-relaxed line-clamp-3 mb-4">
              {s.data.description}
            </p>
            <span class="inline-flex items-center gap-1.5 text-sm font-medium font-[var(--font-button)] text-[var(--color-brand-orange-text)] group-hover:gap-2.5 transition-all">
              Learn more
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============= SELECTED WORK ============= -->
  <section class="relative section-spacing bg-white overflow-hidden">
    <div class="relative mx-auto max-w-[1200px] section-padding">
      <div class="max-w-3xl mb-12 lg:mb-14" data-reveal>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-brand-orange)]/10 border border-[var(--color-brand-orange)]/20 mb-5">
          <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[var(--color-brand-orange)]">Selected work · 作品</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-medium font-[var(--font-heading)] text-[var(--color-text-dark)] leading-[1.1]">
          Sites we shipped for international brands in China.
        </h2>
        <div data-agency-evidence="2" class="my-6 max-w-3xl text-[var(--color-text-body)]">
          <p class="text-base leading-relaxed">Open a project to see what was delivered and which services it used. Compare that scope with your own brief before treating it as evidence for your site.</p>
          <blockquote class="mt-3 border-l-2 border-[var(--color-brand-orange)] pl-4 text-sm leading-relaxed">This page displays 3 published projects selected by catalogue order. Source: ChinaWebFoundry page source, checked 21 October 2026. The count describes the selection shown here, not the agency’s total work.</blockquote>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6">
        {casestudies.map((cs) => (
          <a
            href={`/work/${cs.id}/`}
            data-reveal
            class="group relative block rounded-2xl overflow-hidden no-underline"
          >
            <div class="relative aspect-[4/5]">
              {cs.data.visual ? (
                <img
                  src={cs.data.visual}
                  alt={cs.data.title}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="absolute inset-0" style={`background: linear-gradient(135deg, ${cs.data.color}, ${cs.data.color}dd)`}></div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-6 lg:p-7">
                <h3 class="text-xl font-medium font-[var(--font-heading)] text-white leading-snug mb-2">
                  {cs.data.title}
                </h3>
                <p class="text-sm text-white/70 leading-relaxed line-clamp-2">{cs.data.summary}</p>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-10 text-center" data-reveal>
        <a href="/work/" class="inline-flex items-center gap-2 text-base font-medium font-[var(--font-button)] text-[var(--color-brand-orange-text)] no-underline hover:gap-3 transition-all">
          See all case studies
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============= WHY US ============= -->
  <section class="relative section-spacing bg-[var(--color-surface-light)] overflow-hidden">
    <div class="relative mx-auto max-w-[1200px] section-padding">
      <div class="grid grid-cols-12 gap-8 lg:gap-14 items-center">
        <div class="col-span-12 lg:col-span-6" data-reveal>
          <div class="rounded-3xl overflow-hidden border border-[var(--color-surface-border)] shadow-[0_30px_60px_-30px_rgba(15,15,18,0.2)]">
            <img
              src="/images/team/team-photo.webp"
              alt="ChinaWebFoundry team in Shanghai"
              class="w-full h-auto object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="col-span-12 lg:col-span-6" data-reveal data-reveal-delay="120">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-brand-orange)]/10 border border-[var(--color-brand-orange)]/20 mb-5">
            <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[var(--color-brand-orange)]">Why us · 关于我们</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-medium font-[var(--font-heading)] text-[var(--color-text-dark)] leading-[1.12] mb-6">
            The web agency you brief is the team that ships your site.
          </h2>
        <div data-agency-evidence="3" class="my-6 max-w-3xl text-[var(--color-text-body)]">
          <p class="text-base leading-relaxed">Name an owner for the build. The site will also need someone responsible for its operation after launch; use the team page to start that discussion.</p>
          <blockquote class="mt-3 border-l-2 border-[var(--color-brand-orange)] pl-4 text-sm leading-relaxed"><a href="/who-we-are/" class="underline underline-offset-4">ChinaWebFoundry’s team collection names 2 leaders: Cyril Drouin and Echo Peng. Source: ChinaWebFoundry team collection, checked 21 October 2026.</a></blockquote>
        </div>
          <p class="text-base lg:text-lg text-[var(--color-text-body)] leading-relaxed mb-4">
            ChinaWebFoundry is led by Cyril Drouin, who has lived and worked in China since 2005. Our delivery team is bilingual, Shanghai-based, and works full-time on China web projects. Every line of code, every Chinese sentence and every design decision comes from the people you brief. We never subcontract.
          </p>
          <p class="text-base lg:text-lg text-[var(--color-text-body)] leading-relaxed mb-8">
            When you sign with us, you get our writers, our designers, our developers and our SEO leads. You also get a single point of contact who answers within 24 hours, in your timezone, in English or French.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <Button href="/who-we-are/" variant="primary" size="md">Meet the team</Button>
            <Button href="/contact/" variant="secondary" size="md">Talk to us</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============= FAQ ============= -->
  <section class="relative section-spacing bg-white overflow-hidden">
    <span aria-hidden="true" class="absolute right-[-2rem] top-[6%] text-[18rem] lg:text-[22rem] font-medium font-[var(--font-heading)] text-[var(--color-brand-orange)]/[0.05] leading-none select-none pointer-events-none hidden md:block">问</span>
    <div class="relative mx-auto max-w-[900px] section-padding">
      <div class="max-w-2xl mb-12 lg:mb-14" data-reveal>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-brand-orange)]/10 border border-[var(--color-brand-orange)]/20 mb-5">
          <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-[var(--color-brand-orange)]">Questions · 常见问题</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-medium font-[var(--font-heading)] text-[var(--color-text-dark)] leading-[1.1]">
          About working with a web agency in China.
        </h2>
      </div>

      <div class="space-y-3">
        {faqs.map((f, i) => (
          <details
            class="group rounded-2xl border border-[var(--color-surface-border)] bg-white p-6 lg:p-7 transition-all duration-200 hover:border-[var(--color-brand-orange)]/30 open:border-[var(--color-brand-orange)]/40"
            data-reveal
            data-reveal-delay={String(i * 60)}
          >
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
              <h3 class="text-lg lg:text-xl font-medium font-[var(--font-heading)] text-[var(--color-text-dark)] leading-snug pr-4">
                {f.q}
              </h3>
              <svg class="w-5 h-5 flex-shrink-0 mt-1 text-[var(--color-brand-orange)] transition-transform duration-200 group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
              </svg>
            </summary>
            <p class="mt-4 text-[15px] lg:text-base text-[var(--color-text-body)] leading-relaxed">
              {f.linkText ? <>{f.a.split(f.linkText)[0]}<a href={f.href} class="underline underline-offset-4">{f.linkText}</a>{f.a.split(f.linkText)[1]}</> : f.a}
            </p>
            {f.source && <blockquote class="mt-3 border-l-2 border-[var(--color-brand-orange)] pl-4 text-sm leading-relaxed text-[var(--color-text-body)]"><a href={f.sourceHref} class="underline underline-offset-4">{f.source}</a></blockquote>}
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============= FINAL CTA ============= -->
  <section class="relative py-24 md:py-32 lg:py-36 bg-[#0a0a0e] overflow-hidden">
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-32 -left-20 w-[520px] h-[520px] rounded-full bg-[var(--color-brand-orange)]/[0.18] blur-[160px]"></div>
      <div class="absolute -bottom-32 right-[5%] w-[440px] h-[440px] rounded-full bg-[#FF7E47]/[0.14] blur-[170px]"></div>
      <div class="absolute inset-0 [background-image:radial-gradient(rgba(255,255,255,0.06)_1px,transparent_1px)] [background-size:38px_38px] opacity-50"></div>
    </div>

    <div class="relative mx-auto max-w-[1200px] section-padding text-center">
      <div class="inline-flex items-center gap-2.5 px-3.5 py-2 rounded-full bg-white/[0.08] backdrop-blur-md border border-white/15 mb-7" data-reveal>
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full rounded-full bg-[var(--color-brand-orange)] opacity-70 animate-ping"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--color-brand-orange)]"></span>
        </span>
        <span class="text-[11px] font-semibold uppercase tracking-[0.20em] text-white/95">Booking this quarter</span>
      </div>

      <h2 class="text-4xl sm:text-5xl lg:text-[64px] font-medium font-[var(--font-heading)] text-white leading-[1.02] tracking-tight mb-7" data-reveal data-reveal-delay="80">
        Start the conversation.
        <span class="block">
          <span class="bg-gradient-to-r from-[var(--color-brand-orange)] via-[#FF9466] to-[var(--color-brand-orange)] bg-clip-text text-transparent">
            With your web agency in Shanghai.
          </span>
        </span>
      </h2>
        <div data-agency-evidence="5" class="my-6 max-w-3xl text-white/75">
          <p class="text-base leading-relaxed">Send the brief with your current URL and the action a China visitor should be able to complete.</p>
          <blockquote class="mt-3 border-l-2 border-[var(--color-brand-orange)] pl-4 text-sm leading-relaxed"><a href="/services/" class="underline underline-offset-4">The general agency page lists 10 services for scoping the work. Source: ChinaWebFoundry service catalogue, checked 21 October 2026.</a></blockquote>
        </div>
      <p class="text-base lg:text-xl text-white/65 leading-relaxed max-w-2xl mx-auto mb-9" data-reveal data-reveal-delay="160">
        Send us a brief or book a 30-minute call. A human writes back within 24 hours, in your timezone.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4" data-reveal data-reveal-delay="200">
        <Button href="/contact/" variant="primary" size="lg">Contact us</Button>
        <a
          href="/china-site-scanner/"
          class="inline-flex items-center gap-2 px-7 py-3 text-base font-medium font-[var(--font-button)] rounded-[var(--radius-pill)] border border-white/20 bg-white/[0.04] backdrop-blur-md text-white hover:bg-white/[0.10] hover:border-white/40 hover:-translate-y-0.5 no-underline transition-all duration-200"
        >
          Free China site scan
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</PageLayout>

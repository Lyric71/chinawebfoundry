---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
import FAQItem from '../components/pages/FAQItem.astro';
import ScrollEffects from '../components/global/ScrollEffects.astro';
import PageScrollEffects from '../components/pages/ScrollEffects.astro';
import { getCollection } from 'astro:content';

const metaTitle = 'WordPress Agency in China | Build, Host & Rank | ChinaWebFoundry';
const metaDescription = 'Hire a specialist WordPress agency for China. Firewall-safe hosting, ICP licensing, fast load times and Baidu SEO, built to launch and rank in mainland China.';
const canonicalPath = '/wordpress-agency-china/';

const casestudies = (await getCollection('casestudies'))
  .filter((cs) => cs.data.published)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://www.chinawebfoundry.com';
const pageUrl = `${siteOrigin}${canonicalPath}`;

const services = [
  {
    key: 'dev',
    title: 'WordPress design & development',
    body: 'Custom themes designed for Chinese users and built without a single call to a blocked domain. Responsive, bilingual-ready, tested at 375px on the phones people actually use here.',
    deliverable: 'A production WordPress site verified from mainland connections.',
    href: '/services/ux-ui-design/',
    linkLabel: 'Design & development',
  },
  {
    key: 'hosting',
    title: 'Firewall-safe hosting & CDN',
    body: 'Mainland or Hong Kong hosting on Alibaba Cloud or Tencent Cloud, fronted by a China CDN. We target sub-2-second loads in tier-1 cities and monitor from nodes inside China.',
    deliverable: 'A hosting setup with in-China response times you can check yourself.',
    href: '/services/china-hosting/',
    linkLabel: 'China hosting',
  },
  {
    key: 'icp',
    title: 'ICP licence & regulatory support',
    body: 'We prepare your ICP Bei’an filing, submit it through your host to MIIT, and tell you plainly if your business model needs the commercial licence instead.',
    deliverable: 'An ICP number in your footer, registered to your entity.',
    href: '/resources/china-web-guide/icp-licence-filing-foreign-companies/',
    linkLabel: 'How ICP filing works',
  },
  {
    key: 'seo',
    title: 'Baidu & China SEO',
    body: 'Technical and on-page work for Baidu, Sogou and 360. Baidu Webmaster Tools setup, Simplified Chinese keyword research, and content written by native speakers.',
    deliverable: 'A Baidu-indexed site with a keyword plan and monthly ranking reports.',
    href: '/services/baidu-seo/',
    linkLabel: 'Baidu SEO service',
  },
  {
    key: 'migration',
    title: 'Migration & site rescue',
    body: 'Your WordPress site already exists but crawls or breaks in China. We move it onto China-ready infrastructure and strip the blocked resources, keeping your content and rankings.',
    deliverable: 'The same site, loading in seconds from Shanghai.',
    href: '/services/china-migration/',
    linkLabel: 'China migration',
  },
  {
    key: 'care',
    title: 'Maintenance & support',
    body: 'Core and plugin updates tested against the firewall before they go live, security patching, uptime monitoring from Chinese nodes, and a human who replies within 24 hours.',
    deliverable: 'A monthly report and a site that stays fast.',
    href: '/services/maintenance-support/',
    linkLabel: 'Maintenance plans',
  },
];

const breakages = [
  {
    resource: 'Google Fonts',
    broken: 'Text invisible for 20+ seconds while the browser waits for a timeout.',
    fixed: 'Every font self-hosted as WOFF2 on your own server.',
  },
  {
    resource: 'reCAPTCHA',
    broken: 'Contact forms that never submit. Enquiries silently lost.',
    fixed: 'Honeypot fields and China-friendly anti-spam instead of Google’s widget.',
  },
  {
    resource: 'Google Maps',
    broken: 'A grey box where your office location should be.',
    fixed: 'AutoNavi (Gaode) or Baidu Maps embeds.',
  },
  {
    resource: 'YouTube embeds',
    broken: 'Dead video players across your product pages.',
    fixed: 'Self-hosted video or a Tencent Video / Youku embed.',
  },
  {
    resource: 'Gravatar',
    broken: 'Comment sections and author boxes that stall the whole page.',
    fixed: 'Remote avatars disabled, local images served instead.',
  },
  {
    resource: 'CDN-hosted scripts',
    broken: 'jQuery from ajax.googleapis.com hangs everything that depends on it.',
    fixed: 'Every script bundled and served from your own hosting.',
  },
  {
    resource: 'Google Analytics',
    broken: 'No visitor data, plus one more blocked request on every page.',
    fixed: 'Baidu Tongji or a self-hosted analytics tool such as Matomo.',
  },
];

const processSteps = [
  {
    title: 'Discovery',
    when: 'Weeks 1-2',
    body: 'We audit your current site from a Shanghai connection, map your goals for the China market, and agree scope and budget.',
  },
  {
    title: 'Design',
    when: 'Weeks 2-4',
    body: 'Wireframes and visual design shaped for Chinese users: denser layouts, mobile-first, WeChat-aware.',
  },
  {
    title: 'Build',
    when: 'Weeks 4-8',
    body: 'Theme and plugin development with zero blocked resources. Every dependency self-hosted from the first commit.',
  },
  {
    title: 'China performance testing',
    when: 'Weeks 8-9',
    body: 'We load the site from Beijing, Shanghai and Guangzhou nodes and fix anything slower than 2 seconds before you ever see a staging link.',
  },
  {
    title: 'ICP & hosting setup',
    when: 'In parallel',
    body: 'ICP filing prepared and submitted, hosting and CDN configured. Runs alongside the build, so it costs no extra calendar time.',
  },
  {
    title: 'Baidu SEO foundations',
    when: 'Weeks 9-10',
    body: 'Baidu Webmaster Tools, sitemap submission, Chinese keyword mapping and on-page work, done before launch rather than bolted on after.',
  },
  {
    title: 'Launch',
    when: 'Week 10',
    body: 'DNS switch, CDN warm-up, and a launch-day check from mainland connections.',
  },
  {
    title: 'Support',
    when: 'Ongoing',
    body: 'Updates, monitoring and monthly reporting under a maintenance plan. Most clients stay with us for years.',
  },
];

const alternatives = [
  {
    title: 'WordPress, localised properly',
    body: 'The right choice when your team already knows the editor, you publish often, or you run multilingual content. Hosted in China with local assets, it loads in under 2 seconds and Baidu indexes it well.',
    verdict: 'Our default for content-led brand sites.',
  },
  {
    title: 'WeChat-only or a local CMS',
    body: 'A WeChat official account matters in China and we build for it. On its own though, you rent your audience from Tencent, and a local CMS locks your content into a platform your HQ team can’t use.',
    verdict: 'Good alongside a website. Risky as a replacement for one.',
  },
  {
    title: 'Astro or headless',
    body: 'When raw speed wins and content changes rarely, a static or headless build beats WordPress on performance. We build these too, and we’ll recommend one when it fits.',
    verdict: 'The brief decides the stack. If WordPress is wrong for your project, we say so on the first call.',
  },
];

const industries = [
  'B2B & industrial',
  'Education & universities',
  'Hospitality & travel',
  'Luxury & consumer brands',
  'SaaS & technology',
  'Life sciences',
  'MNCs entering China',
];

const differentiators = [
  {
    title: 'We test where your visitors are',
    body: 'Every build is checked from Chinese connections in Beijing, Shanghai and Guangzhou. A green light in Frankfurt means nothing to a visitor in Chengdu.',
  },
  {
    title: 'ICP handled in Mandarin',
    body: 'Our team files ICP paperwork directly with hosts and MIIT, in Mandarin, and has done so for years. You sign documents; we do the rest.',
  },
  {
    title: 'Baidu expertise in-house',
    body: 'Chinese keyword research, Baidu Webmaster Tools and Chinese content written by native speakers. The same team that builds your site ranks it.',
  },
  {
    title: 'Bilingual, single point of contact',
    body: 'One account lead who answers in English or French within 24 hours, backed by a Shanghai delivery team. We never subcontract.',
  },
];

const faqs = [
  {
    id: 'works-in-china',
    q: 'Does WordPress actually work in China?',
    a: 'Yes, when it’s hosted in or near China and stripped of blocked resources. WordPress core itself is fine; the problems come from themes and plugins that call Google Fonts, reCAPTCHA, Gravatar and other blocked services. We’ve shipped 50+ WordPress sites that load in under 2 seconds from mainland connections.',
  },
  {
    id: 'icp-needed',
    q: 'Do I need an ICP licence for my WordPress site?',
    a: 'Only if you host in mainland China. The basic ICP Bei’an filing covers brochure and marketing sites and requires a Chinese legal entity. Selling directly to Chinese consumers from the site usually means the commercial ICP licence, which has stricter requirements. If you have no Chinese entity, Hong Kong hosting skips the ICP entirely and still performs well.',
  },
  {
    id: 'fix-without-rebuild',
    q: 'My existing WordPress site is slow in China. Can you fix it without a rebuild?',
    a: 'Usually, yes. Most slow sites suffer from blocked third-party resources and distant hosting, and both are fixable without touching your design or content. We migrate the site to China-ready hosting, localise fonts and scripts, and swap the plugins that break. Run our free China site scanner to see exactly what’s blocking yours.',
  },
  {
    id: 'timeline',
    q: 'How long does it take to launch a WordPress site in China?',
    a: 'A new brand site takes 8 to 12 weeks from kickoff to launch. Migrating and localising an existing global site takes 14 to 20 weeks including content rewrite and Baidu indexing. The ICP filing takes 2 to 4 weeks and runs in parallel with the build.',
  },
  {
    id: 'woocommerce',
    q: 'Does WooCommerce work in China?',
    a: 'Yes, with local adjustments. Checkout needs WeChat Pay and Alipay rather than Stripe or PayPal, and selling domestically requires the commercial ICP licence plus a Chinese entity. Many foreign brands start with cross-border e-commerce instead, which has lighter requirements. We’ve built both.',
  },
  {
    id: 'google-rankings',
    q: 'Will optimising for China hurt my Google rankings elsewhere?',
    a: 'No. Your China site runs alongside your global site, usually on a subdomain or a .cn domain, with hreflang tags telling Google and Baidu which version serves which audience. Your existing rankings stay where they are.',
  },
  {
    id: 'chinese-content',
    q: 'Can you handle Simplified Chinese content and multilingual setup?',
    a: 'Yes. We work with WPML and Polylang for multilingual WordPress, and our native Chinese writers produce the Simplified Chinese content. Machine-translated Chinese reads as poorly to Chinese buyers as machine-translated English reads to you, so we don’t use it.',
  },
  {
    id: 'cost',
    q: 'How much does a China WordPress project cost?',
    a: 'It depends on page count, whether you need an ICP filing, the hosting tier, localisation volume and any e-commerce. We quote a fixed price after a scoping call, and the call and quote are free. Ongoing maintenance and hosting run on a flat monthly retainer.',
  },
];

// Service schema reinforcing the "WordPress agency in China" entity for this page
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: 'WordPress agency in China',
  description: 'Specialist WordPress agency for the China market. Design, development, firewall-safe hosting, ICP licensing, Baidu SEO, migration and maintenance for WordPress sites in mainland China.',
  serviceType: 'WordPress development',
  provider: { '@id': `${siteOrigin}/#organization` },
  areaServed: { '@type': 'Country', name: 'China' },
  url: pageUrl,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'WordPress services for China',
    itemListElement: services.map((s, i) => ({
      '@type': 'Offer',
      position: i + 1,
      itemOffered: {
        '@type': 'Service',
        name: s.title,
        description: s.body,
        url: `${siteOrigin}${s.href}`,
      },
    })),
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'WordPress agency in China', item: pageUrl },
  ],
};
---

<PageLayout
  title={metaTitle}
  description={metaDescription}
  heroPage={true}
  jsonLd={[serviceLd, faqLd, breadcrumbLd]}
  alternateUrls={{ en: canonicalPath, fr: canonicalPath, es: canonicalPath, de: canonicalPath }}
>
  <ScrollEffects />
  <PageScrollEffects />

  <!-- ============= HERO with live network simulation ============= -->
  <section
    data-hero
    class="relative bg-[var(--color-surface-dark)] overflow-hidden flex flex-col"
  >
    <div class="absolute inset-0">
      <img
        src="/images/hero-wordpress-agency-china.webp"
        alt=""
        width="1600"
        height="900"
        class="absolute inset-0 w-full h-full object-cover scale-105 opacity-60"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0e]/97 via-[#0a0a0e]/88 to-[#0a0a0e]/60"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0e]/70 via-transparent to-[#0a0a0e]"></div>
    </div>

    <div aria-hidden="true" class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute top-[8%] -left-32 w-[600px] h-[600px] rounded-full bg-[var(--color-brand-orange)]/[0.16] blur-[140px]"></div>
      <div class="absolute bottom-[5%] right-[15%] w-[500px] h-[500px] rounded-full bg-[#EF4444]/[0.08] blur-[160px]"></div>
    </div>

    <div
      aria-hidden="true"
      class="absolute inset-0 [background-image:radial-gradient(rgba(255,255,255,0.07)_1px,transparent_1px)] [background-size:38px_38px] pointer-events-none"
    ></div>

    <div class="relative z-10 mx-auto w-full max-w-[1240px] section-padding flex-1 pt-32 lg:pt-40 pb-16 lg:pb-24">
      <div class="grid grid-cols-12 gap-10 lg:gap-8 items-center">
        <!-- Left: headline -->
        <div class="col-span-12 lg:col-span-6">
          <div class="flex items-center gap-3 mb-6">
            <div class="h-px w-10 bg-[var(--color-brand-orange)]"></div>
            <span class="text-xs lg:text-sm font-medium tracking-[0.18em] text-[var(--color-brand-orange)] uppercase">
              WordPress specialists · Based in Shanghai
            </span>
          </div>

          <h1 class="text-[clamp(2.3rem,4.6vw,3.9rem)] font-medium font-[var(--font-heading)] text-white leading-[1.04] tracking-tight">
            WordPress agency in China:
            <span class="block mt-2">
              <span class="bg-gradient-to-r from-[var(--color-brand-orange)] via-[#FF9466] to-[var(--color-brand-orange)] bg-clip-text text-transparent">
                build, host and rank
              </span>
            </span>
            <span class="block mt-2 text-white/95">behind the Great Firewall.</span>
          </h1>

          <p class="mt-7 text-base lg:text-lg text-white/65 leading-relaxed max-w-[560px]">
            We design, build, host and maintain WordPress sites that load in under 2 seconds inside mainland China. ICP licensing, firewall-safe hosting and Baidu SEO, all handled by one Shanghai-based team.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-4">
            <Button href="/contact/" variant="primary" size="lg">Request a quote</Button>
            <a
              href="/china-site-scanner/"
              class="inline-flex items-center gap-2 px-7 py-3 text-base font-medium font-[var(--font-button)] rounded-[var(--radius-pill)] border border-white/20 bg-white/[0.04] backdrop-blur-md text-white hover:bg-white/[0.10] hover:border-white/40 hover:-translate-y-0.5 no-underline transition-all duration-200"
            >
              Free China readiness audit
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>

          <div class="mt-12 grid grid-cols-3 gap-6 max-w-xl">
            <div class="border-l-2 border-[var(--color-brand-orange)]/70 pl-4">
              <div class="text-2xl lg:text-3xl font-medium font-[var(--font-heading)] text-white leading-none"><span data-counter data-counter-suffix="+">50</span></div>
              <div class="text-[10px] uppercase tracking-[0.18em] text-white/50 mt-2">WordPress sites shipped</div>
            </div>
            <div class="border-l-2 border-white/15 pl-4">
              <div class="text-2xl lg:text-3xl font-medium font-[var(--font-heading)] text-white leading-none"><span data-counter data-counter-suffix="+">15</span></div>
              <div class="text-[10px] uppercase tracking-[0.18em] text-white/50 mt-2">Years in China</div>
            </div>
            <div class="border-l-2 border-white/15 pl-4">
              <div class="text-2xl lg:text-3xl font-medium font-[var(--font-heading)] text-white leading-none">&lt;2s</div>
              <div class="text-[10px] uppercase tracking-[0.18em] text-white/50 mt-2">Load time in tier-1 cities</div>
            </div>
          </div>
        </div>

        <!-- Right: live network panel simulation (the signature) -->
        <div class="col-span-12 lg:col-span-6" data-reveal="right">
          <div id="net-sim" class="relative max-w-[560px] mx-auto lg:ml-auto rounded-2xl border border-white/12 bg-[#101016]/90 backdrop-blur-md shadow-[0_40px_90px_-30px_rgba(0,0,0,0.8)] overflow-hidden">
            <!-- window chrome -->
            <div class="flex items-center gap-3 px-4 py-3 border-b border-white/10 bg-white/[0.03]">
              <div class="flex gap-1.5" aria-hidden="true">
                <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#FEBC2E]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#28C840]"></span>
              </div>
              <div class="flex-1 flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/[0.06] text-[12px] font-mono text-white/60 truncate">
                <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 3.935"/></svg>
                yourbrand.com
              </div>
              <div class="hidden sm:flex items-center gap-1.5 text-[11px] font-mono text-white/50 shrink-0">
                <svg class="w-3.5 h-3.5 text-[var(--color-brand-orange)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Shanghai, CN
              </div>
            </div>

            <!-- loading bar -->
            <div class="h-[3px] bg-white/[0.06]">
              <div id="sim-progress" class="h-full w-0 bg-[#EF4444] transition-none"></div>
            </div>

            <!-- phase + timer -->
            <div class="flex items-center justify-between px-4 pt-3.5 pb-1">
              <span id="sim-phase" class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[0.14em] text-white/60">
                <span id="sim-phase-dot" class="w-1.5 h-1.5 rounded-full bg-[#EF4444]"></span>
                <span id="sim-phase-label">Standard WordPress install</span>
              </span>
              <span class="text-[13px] font-mono text-white/80 tabular-nums">
                <span id="sim-timer">0.0</span>s
              </span>
            </div>

            <!-- request rows -->
            <div id="sim-rows" class="px-4 pb-3 pt-1.5 min-h-[248px] flex flex-col gap-1.5" aria-live="off"></div>

            <!-- verdict -->
            <div id="sim-verdict" class="mx-4 mb-4 rounded-lg px-3.5 py-2.5 text-[12.5px] font-mono border border-white/10 bg-white/[0.04] text-white/45 transition-colors duration-500">
              Waiting for first request...
            </div>
          </div>
          <p class="mt-3 text-center lg:text-right text-[11px] font-mono uppercase tracking-[0.14em] text-white/35">
            Simulation · based on real audits we run daily
          </p>
        </div>
      </div>
    </div>

    <!-- Firewall divider -->
    <div class="relative z-10 border-t border-white/[0.07]">
      <div class="mx-auto max-w-[1240px] section-padding py-4 flex items-center justify-between gap-4">
        <span class="hidden md:block text-[10px] font-mono uppercase tracking-[0.2em] text-white/35">Your server · Frankfurt</span>
        <span class="flex-1 h-px bg-gradient-to-r from-transparent via-[#EF4444]/60 to-transparent relative">
          <span class="absolute inset-0 h-px bg-gradient-to-r from-transparent via-[var(--color-brand-orange)]/70 to-transparent animate-pulse"></span>
        </span>
        <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[var(--color-brand-orange)]/90 whitespace-nowrap">防火长城 · The Great Firewall</span>
        <span class="flex-1 h-px bg-gradient-to-r from-transparent via-[#EF4444]/60 to-transparent relative">
          <span class="absolute inset-0 h-px bg-gradient-to-r from-transparent via-[var(--color-brand-orange)]/70 to-transparent animate-pulse"></span>
        </span>
        <span class="hidden md:block text-[10px] font-mono uppercase tracking-[0.2em] text-white/35">Your buyers · Shanghai</span>
      </div>
    </div>
  </section>

  <!-- ============= WHY A SPECIALIST + viewport switcher ============= -->
  <section class="relative section-spacing bg-white overflow-hidden">
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-32 right-[8%] w-[500px] h-[500px] rounded-full bg-[var(--color-brand-orange)]/[0.06] blur-[140px]"></div>
      <div class="absolute inset-0 [background-image:radial-gradient(var(--color-text-dark)_1px,transparent_1px)] [background-size:34px_34px] opacity-[0.03]"></div>
    </div>

    <div class="relative mx-auto max-w-[1240px] section-padding">
      <div class="grid grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="col-span-12 lg:col-span-6" data-reveal="left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#EF4444]/[0.08] border border-[#EF4444]/20 mb-5">
            <span class="text-[11px] font-mono font-semibold uppercase tracking-[0.16em] text-[#DC2626]">The problem · 问题</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-medium font-[var(--font-heading)] text-[var(--color-text-dark)] leading-[1.1] mb-6">
            Why a standard WordPress site fails in China.
          </h2>
          <p class="text-base lg:text-lg text-[var(--color-text-body)] leading-relaxed mb-4">
            Take a WordPress site built for Europe or North America and open it in Shanghai. It loads in 20 to 40 seconds, if it loads at all. The theme calls Google Fonts. The contact form waits on reCAPTCHA. The footer map calls Google Maps. The Great Firewall blocks all 3, and each one hangs the page while the browser waits for a timeout.
          </p>
          <p class="text-base lg:text-lg text-[var(--color-text-body)] leading-relaxed mb-4">
            Distance makes it worse. Every request travels from the visitor in China to a server in Frankfurt or Virginia through congested international gateways. And without an ICP filing you can't host in mainland China or use a mainland CDN, so there's no way to shorten that trip.
          </p>
          <p class="text-base lg:text-lg text-[var(--color-text-body)] leading-relaxed mb-8">
            A China-specialist WordPress agency deals with all of this before launch. Flip the viewer to see what your buyers see. Then run the real test on your own site.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <Button href="/china-site-scanner/" variant="primary" size="md">Run a free China readiness audit</Button>
            <Button href="/contact/" variant="secondary" size="md">Request a quote</Button>
          </div>
        </div>

        <!-- Viewport switcher: same site, two places -->
        <div class="col-span-12 lg:col-span-6" data-reveal="right">

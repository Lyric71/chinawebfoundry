  .tl-step.is-active .tl-dot-core { background: var(--color-brand-orange); }

  /* ---------- marquee ---------- */
  .marquee-track { animation: marquee 36s linear infinite; }
  .marquee-track:hover { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
    .sim-row { animation: none; opacity: 1; transform: none; }
    .svc-card .lat-bar { transform: scaleX(1); transition: none; }
    .fix-row, .fix-dot, .fix-chip-fixed { transition: none; animation: none; }
  }
</style>

<script>
  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  /* ============ 1. Hero network simulation ============ */
  const BROKEN_REQUESTS = [
    { url: 'yourbrand.com', status: 'ok', label: '200 · 1.9s', t: 1.9 },
    { url: 'fonts.googleapis.com/css2?family=...', status: 'blocked', label: 'Blocked', t: 5.2 },
    { url: 'fonts.gstatic.com/s/opensans.woff2', status: 'blocked', label: 'Blocked', t: 7.8 },
    { url: 'ajax.googleapis.com/jquery.min.js', status: 'slow', label: '8.4s', t: 10.6 },
    { url: 'maps.googleapis.com/maps/api/js', status: 'blocked', label: 'Blocked', t: 14.1 },
    { url: 'www.google.com/recaptcha/api.js', status: 'blocked', label: 'Blocked', t: 17.9 },
    { url: 'youtube.com/embed/product-tour', status: 'blocked', label: 'Blocked', t: 20.7 },
    { url: 'gravatar.com/avatar/9f8b2c...', status: 'blocked', label: 'Blocked', t: 23.4 },
  ];
  const FIXED_REQUESTS = [
    { url: 'yourbrand.cn', status: 'ok', label: '200 · 0.3s', t: 0.3 },
    { url: 'yourbrand.cn/fonts/poppins.woff2', status: 'ok', label: '200 · 0.1s', t: 0.5 },
    { url: 'yourbrand.cn/assets/app.min.js', status: 'ok', label: '200 · 0.2s', t: 0.8 },
    { url: 'webapi.amap.com/maps (Gaode)', status: 'ok', label: '200 · 0.3s', t: 1.2 },
    { url: 'cdn.yourbrand.cn/img/hero.webp', status: 'ok', label: '200 · 0.2s', t: 1.5 },
    { url: 'hm.baidu.com/tongji.js', status: 'ok', label: '200 · 0.1s', t: 1.8 },
  ];

  function initNetSim() {
    const sim = document.getElementById('net-sim');
    const rowsEl = document.getElementById('sim-rows');
    const timerEl = document.getElementById('sim-timer');
    const phaseLabel = document.getElementById('sim-phase-label');
    const phaseDot = document.getElementById('sim-phase-dot');
    const progress = document.getElementById('sim-progress');
    const verdict = document.getElementById('sim-verdict');
    if (!sim || !rowsEl || !timerEl || !phaseLabel || !phaseDot || !progress || !verdict) return;
    if ((sim as HTMLElement).dataset.simBound === 'true') return;
    (sim as HTMLElement).dataset.simBound = 'true';

    function renderRow(req: { url: string; status: string; label: string }) {
      const row = document.createElement('div');
      row.className = 'sim-row';
      row.innerHTML = `<span class="sim-url">GET ${req.url}</span><span class="sim-status ${req.status}">${req.label}</span>`;
      rowsEl!.appendChild(row);
    }

    function renderStatic() {
      rowsEl!.innerHTML = '';
      BROKEN_REQUESTS.forEach(renderRow);
      timerEl!.textContent = '23.4';
      progress!.style.width = '38%';
      verdict!.textContent = '6 of 8 requests blocked · page unusable in China';
      verdict!.className = verdict!.className.replace(/text-white\/45/, 'text-[#F87171]');
    }

    if (prefersReducedMotion()) {
      renderStatic();
      return;
    }

    let timeouts: number[] = [];
    let rafId = 0;
    let running = false;

    function clearAll() {
      timeouts.forEach((t) => clearTimeout(t));
      timeouts = [];
      cancelAnimationFrame(rafId);
    }

    function animateTimer(from: number, to: number, durationMs: number, color: string) {
      const start = performance.now();
      progress!.style.background = color;
      function tick(now: number) {
        const p = Math.min(1, (now - start) / durationMs);
        const val = from + (to - from) * p;
        timerEl!.textContent = val.toFixed(1);
        progress!.style.width = `${Math.min(96, p * (to > 5 ? 40 : 100))}%`;
        if (p < 1) rafId = requestAnimationFrame(tick);
      }
      rafId = requestAnimationFrame(tick);
    }

    const SPEED = 380; // ms per simulated second

    function runPhase(requests: typeof BROKEN_REQUESTS, opts: { name: string; dot: string; done: string; doneClass: string; nextDelay: number; next: () => void }) {
      rowsEl!.innerHTML = '';
      verdict!.textContent = 'Loading...';
      verdict!.style.color = 'rgba(255,255,255,0.45)';
      verdict!.style.borderColor = 'rgba(255,255,255,0.1)';
      phaseLabel!.textContent = opts.name;
      (phaseDot as HTMLElement).style.background = opts.dot;
      const total = requests[requests.length - 1].t;
      animateTimer(0, total, total * SPEED, opts.dot);
      requests.forEach((req) => {
        timeouts.push(window.setTimeout(() => renderRow(req), req.t * SPEED));
      });
      timeouts.push(
        window.setTimeout(() => {
          verdict!.textContent = opts.done;
          verdict!.style.color = opts.doneClass;
          verdict!.style.borderColor = opts.doneClass + '55';
          progress!.style.width = '100%';
        }, total * SPEED + 200),
      );
      timeouts.push(window.setTimeout(opts.next, total * SPEED + opts.nextDelay));
    }

    function loop() {
      runPhase(BROKEN_REQUESTS, {
        name: 'Standard WordPress install',
        dot: '#EF4444',
        done: '6 of 8 requests blocked · visitors give up',
        doneClass: '#F87171',
        nextDelay: 3200,
        next: () =>
          runPhase(FIXED_REQUESTS, {
            name: 'After our rebuild',
            dot: '#22C55E',
            done: 'Loaded in 1.8s · 0 blocked requests',
            doneClass: '#4ADE80',
            nextDelay: 4200,
            next: loop,
          }),
      });
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !running) {
            running = true;
            loop();
          } else if (!entry.isIntersecting && running) {
            running = false;
            clearAll();
          }
        });
      },
      { threshold: 0.35 },
    );
    io.observe(sim);
  }

  /* ============ 2. Viewport switcher ============ */
  function initViewSwitch() {
    const wrap = document.getElementById('view-switch');
    if (!wrap || wrap.dataset.bound === 'true') return;
    wrap.dataset.bound = 'true';
    wrap.querySelectorAll<HTMLButtonElement>('[data-view-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        wrap.setAttribute('data-view', btn.dataset.viewBtn || 'shanghai');
      });
    });
  }

  /* ============ 3. Fix switchboard ============ */
  function initFixToggle() {
    const toggle = document.getElementById('fix-toggle');
    const rows = document.getElementById('fix-rows');
    const labelBefore = document.getElementById('fix-label-before');
    const labelAfter = document.getElementById('fix-label-after');
    if (!toggle || !rows || toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';

    function setState(fixed: boolean) {
      rows!.setAttribute('data-state', fixed ? 'fixed' : 'broken');
      toggle!.setAttribute('aria-checked', String(fixed));
      labelBefore?.classList.toggle('text-[#DC2626]', !fixed);
      labelBefore?.classList.toggle('text-[var(--color-text-muted)]', fixed);
      labelAfter?.classList.toggle('text-[#15803D]', fixed);
      labelAfter?.classList.toggle('text-[var(--color-text-muted)]', !fixed);
    }

    toggle.addEventListener('click', () => {
      setState(rows.getAttribute('data-state') !== 'fixed');
    });

    // One-time auto demo: flip to "fixed" shortly after the section scrolls into view
    if (!prefersReducedMotion()) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            io.disconnect();
            window.setTimeout(() => {
              if (rows.getAttribute('data-state') === 'broken') setState(true);
            }, 1600);
          });
        },
        { threshold: 0.45 },
      );
      io.observe(rows);
    }
  }

  /* ============ 4. Entity picker ============ */
  function initEntityPicker() {
    const picker = document.getElementById('entity-picker');
    const options = document.getElementById('hosting-options');
    if (!picker || !options || picker.dataset.bound === 'true') return;
    picker.dataset.bound = 'true';
    picker.querySelectorAll<HTMLButtonElement>('[data-entity]').forEach((btn) => {
      btn.addEventListener('click', () => {
        picker.querySelectorAll('.entity-btn').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        options.setAttribute('data-choice', btn.dataset.entity || '');
      });
    });
  }

  /* ============ 5. Timeline scroll fill ============ */
  function initTimeline() {
    const timeline = document.getElementById('timeline');
    const fill = document.getElementById('timeline-fill');
    if (!timeline || !fill || timeline.dataset.bound === 'true') return;
    timeline.dataset.bound = 'true';
    const steps = Array.from(timeline.querySelectorAll<HTMLElement>('.tl-step'));

    function update() {
      const rect = timeline!.getBoundingClientRect();
      const vh = window.innerHeight;
      const anchor = vh * 0.62;
      const progress = Math.min(1, Math.max(0, (anchor - rect.top) / rect.height));
      fill!.style.height = `${(progress * 100).toFixed(1)}%`;
      steps.forEach((step) => {
        const sRect = step.getBoundingClientRect();
        step.classList.toggle('is-active', sRect.top < anchor);
      });
    }

    if (prefersReducedMotion()) {
      fill.style.height = '100%';
      steps.forEach((s) => s.classList.add('is-active'));
      return;
    }

    let raf = 0;
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(() => { update(); raf = 0; });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  function bootWpChina() {
    initNetSim();
    initViewSwitch();
    initFixToggle();
    initEntityPicker();
    initTimeline();
  }

  bootWpChina();
  document.addEventListener('astro:page-load', bootWpChina);
</script>

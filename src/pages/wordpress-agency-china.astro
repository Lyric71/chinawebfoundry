  #fix-toggle[aria-checked='true'] { background: rgba(34, 197, 94, 0.15); border-color: rgba(34, 197, 94, 0.4); }
  #fix-toggle[aria-checked='true'] #fix-knob { left: calc(100% - 1.75rem); background: #22c55e; }

  /* ---------- entity picker + hosting cards ---------- */

---
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';

const guides = (await getCollection('guides'))
  .filter((guide) => guide.data.published)
  .sort((a, b) => {
    const dateA = a.data.publishedAt?.getTime() ?? 0;
    const dateB = b.data.publishedAt?.getTime() ?? 0;
    return dateB - dateA;
  });

const categories = ['Technology', 'Hosting', 'Content', 'Design', 'Legal', 'Search'] as const;

const PAGE_SIZE = 12;
---

<PageLayout
  title="China Web Guide | What you need to know to run a site in China"
  description="Practical, no-fluff articles on running a website in China for international brands. Written by the Shanghai team that does the work, not desktop researchers."
  heroPage={true}
  breadcrumbName="China Web Guide"
>
  <!-- Hero -->
  <section class="relative bg-[var(--color-surface-dark)] overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-br from-[#0f0f12] via-[#1a1a2e] to-[#0f0f12]"></div>
    </div>

    <div class="relative mx-auto max-w-[1400px] section-padding pt-32 lg:pt-40 pb-24 md:pb-32">
      <div class="io-grid items-start gap-y-10">
        <div class="col-span-12 lg:col-span-7">
          <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-brand-orange-text)] mb-5">
            China Web Guide
          </p>
          <h1 class="text-3xl sm:text-4xl lg:text-[48px] font-medium font-[var(--font-heading)] text-white leading-[1.08]">
            What you need to know<br />about the web in China
          </h1>
        </div>
        <div class="col-span-12 lg:col-span-4 lg:col-start-9 lg:pt-10">
          <p class="text-lg text-white/60 leading-relaxed">
            Practical, no-fluff articles about running a website behind the Great Firewall.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Filters + Articles Grid -->
  <section class="py-20 md:py-28 lg:py-36">
    <div class="mx-auto max-w-[1400px] section-padding">

      <!-- Filter buttons -->
      <div class="flex flex-wrap gap-2 mb-12 scroll-mt-32" id="guide-filters">
        <button
          type="button"
          class="filter-btn is-active px-4 py-2 rounded-full text-sm font-medium font-[var(--font-button)] border transition-all duration-200 cursor-pointer bg-[var(--color-text-dark)] text-white border-[var(--color-text-dark)]"
          data-filter="all"
        >
          All
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            class="filter-btn px-4 py-2 rounded-full text-sm font-medium font-[var(--font-button)] border transition-all duration-200 cursor-pointer bg-white text-[var(--color-text-body)] border-[var(--color-surface-border)] hover:border-[var(--color-brand-orange)] hover:text-[var(--color-brand-orange)]"
            data-filter={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Articles grid (cards past the first page are hidden until the script pages through them) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" id="guide-grid" data-page-size={PAGE_SIZE}>
        {guides.map((guide, index) => (
          <a
            href={`/resources/china-web-guide/${guide.id}/`}
            class="guide-card group flex flex-col bg-white border border-[var(--color-surface-border)] rounded-2xl overflow-hidden no-underline transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_32px_rgba(0,0,0,0.08)] hover:border-[var(--color-brand-orange)]/30"
            data-category={guide.data.category}
            hidden={index >= PAGE_SIZE}
          >
            <div class="aspect-[16/9] bg-[var(--color-surface-light)] overflow-hidden">
              <img
                src={guide.data.visual}
                alt=""
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="flex flex-col flex-1 p-6 lg:p-7">
              <span class="inline-block self-start px-2.5 py-0.5 rounded-md text-xs font-medium bg-[var(--color-surface-light)] text-[var(--color-text-muted)] mb-3">
                {guide.data.category}
              </span>
              <h2 class="text-xl font-medium font-[var(--font-heading)] text-[var(--color-text-dark)] leading-snug mb-2">
                {guide.data.title}
              </h2>
              <p class="text-sm text-[var(--color-brand-orange-text)] font-medium mb-3 line-clamp-2">
                {guide.data.subtitle}
              </p>
              <p class="text-sm text-[var(--color-text-body)] leading-relaxed mb-6 flex-1">
                {guide.data.summary}
              </p>
              <span class="inline-flex items-center gap-2 text-sm font-medium font-[var(--font-button)] text-[var(--color-brand-orange-text)] group-hover:gap-3 transition-all duration-200">
                Read article
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Without JavaScript, show every article -->
      <noscript><style is:inline>.guide-card[hidden] { display: flex !important; }</style></noscript>

      <!-- Pagination (built by the script) -->
      <nav
        id="guide-pagination"
        aria-label="Guide pages"
        class="mt-12 md:mt-16 flex flex-wrap items-center justify-center gap-2"
        hidden
      ></nav>
      <p id="guide-page-status" class="sr-only" aria-live="polite"></p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-[1400px] section-padding text-center">
      <h2 class="text-3xl sm:text-4xl font-medium font-[var(--font-heading)] text-[var(--color-text-dark)] leading-tight mb-6">
        Need help with your China web strategy?
      </h2>
      <p class="text-lg text-[var(--color-text-body)] leading-relaxed max-w-2xl mx-auto mb-10">
        These guides cover the basics. If you need hands-on help getting your WordPress site working in China, we're here for that.
      </p>
      <Button href="/contact/" variant="primary" size="lg">Talk to us</Button>
    </div>
  </section>
</PageLayout>

<script>
  const grid = document.getElementById('guide-grid');
  const filters = document.getElementById('guide-filters');
  const pagination = document.getElementById('guide-pagination');
  const status = document.getElementById('guide-page-status');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.guide-card'));

  const pageSize = Number(grid?.dataset.pageSize) || 12;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const filterActive = ['is-active', 'bg-[var(--color-text-dark)]', 'text-white', 'border-[var(--color-text-dark)]'];
  const filterIdle = ['bg-white', 'text-[var(--color-text-body)]', 'border-[var(--color-surface-border)]'];

  const pageBase = 'inline-flex items-center justify-center gap-2 h-10 min-w-10 px-3 rounded-full text-sm font-medium font-[var(--font-button)] border transition-all duration-200';
  const pageIdle = 'cursor-pointer bg-white text-[var(--color-text-body)] border-[var(--color-surface-border)] hover:border-[var(--color-brand-orange)] hover:text-[var(--color-brand-orange)]';
  const pageCurrent = 'bg-[var(--color-text-dark)] text-white border-[var(--color-text-dark)]';
  const pageDisabled = 'cursor-not-allowed opacity-40 bg-white text-[var(--color-text-body)] border-[var(--color-surface-border)]';

  const arrowLeft = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>';
  const arrowRight = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>';

  let filter = 'all';
  let page = 1;

  function pageButton(html: string, target: number, opts: { current?: boolean; disabled?: boolean; label?: string } = {}) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = `${pageBase} ${opts.current ? pageCurrent : opts.disabled ? pageDisabled : pageIdle}`;
    btn.innerHTML = html;
    if (opts.label) btn.setAttribute('aria-label', opts.label);
    if (opts.current) btn.setAttribute('aria-current', 'page');
    if (opts.disabled) btn.disabled = true;
    if (!opts.current && !opts.disabled) {
      btn.addEventListener('click', () => {
        page = target;
        render(true);
        // Scroll back up to the filters so the new cards start at the top.
        filters?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      });
    }
    return btn;
  }

  function renderPagination(totalPages: number) {
    if (!pagination) return;
    pagination.hidden = totalPages <= 1;
    if (totalPages <= 1) {
      pagination.replaceChildren();
      return;
    }

    const items = [
      pageButton(`${arrowLeft}<span class="hidden sm:inline">Previous</span>`, page - 1, { disabled: page === 1, label: 'Previous page' }),
    ];
    for (let n = 1; n <= totalPages; n++) {
      items.push(pageButton(String(n), n, { current: n === page, label: `Page ${n}` }));
    }
    items.push(pageButton(`<span class="hidden sm:inline">Next</span>${arrowRight}`, page + 1, { disabled: page === totalPages, label: 'Next page' }));
    pagination.replaceChildren(...items);
  }

  function syncUrl() {
    const url = new URL(window.location.href);
    if (filter === 'all') url.searchParams.delete('topic');
    else url.searchParams.set('topic', filter);
    if (page > 1) url.searchParams.set('page', String(page));
    else url.searchParams.delete('page');
    history.replaceState(history.state, '', url);
  }

  function render(fromUser = false) {
    const matching = cards.filter((card) => filter === 'all' || card.dataset.category === filter);
    const totalPages = Math.max(1, Math.ceil(matching.length / pageSize));
    page = Math.min(Math.max(1, page), totalPages);

    const start = (page - 1) * pageSize;
    const visible = new Set(matching.slice(start, start + pageSize));
    cards.forEach((card) => {
      card.hidden = !visible.has(card);
    });

    renderPagination(totalPages);
    syncUrl();

    if (fromUser) {
      if (status) status.textContent = totalPages > 1 ? `Page ${page} of ${totalPages}` : '';
    }
  }

  function setActiveFilter() {
    buttons.forEach((b) => {
      const isActive = b.dataset.filter === filter;
      b.classList.remove(...(isActive ? filterIdle : filterActive));
      b.classList.add(...(isActive ? filterActive : filterIdle));
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filter = btn.dataset.filter ?? 'all';
      page = 1;
      setActiveFilter();
      render(true);
    });
  });

  // Preselect a topic and page passed in the URL, e.g. ?topic=Search (used by the service pages) or ?page=2.
  const params = new URLSearchParams(window.location.search);
  const topic = params.get('topic');
  if (topic && Array.from(buttons).some((b) => b.dataset.filter === topic)) filter = topic;
  page = Number.parseInt(params.get('page') ?? '1', 10) || 1;
  setActiveFilter();
  render();
</script>

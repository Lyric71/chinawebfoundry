  @media (max-height: 780px) {
    .cdi-hero {
      padding-top: 68px;
      padding-bottom: 14px;
    }
    .cdi-hero h1 {
      font-size: clamp(1.55rem, 3.4vw, 2.55rem);
    }
  }
